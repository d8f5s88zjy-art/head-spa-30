    "text-3": "{--text-tertiary}",
    "akcent": "{--accent}",
    "zvyraznenie": "{--accent}",
    "na-akcente": "#17110a",
    "stitok": "{--accent}",
    "linka": "{--line}",
    "linka-silna": "{--line-strong}",
    "doska": "rgba({--ink}, 0.72)"
  },
  "farby_zaloha": {
    "podklad": "#0d0a07",
    "plocha": "#14100c",
    "text": "#efe7da",
    "text-2": "#bfb3a2",
