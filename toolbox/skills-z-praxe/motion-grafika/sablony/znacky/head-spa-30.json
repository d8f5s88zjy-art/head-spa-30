{
  "nazov": "HEAD SPA 30",
  "zdroj": "CLAUDE.md (Technika), assets/style.css časť Luxusná vrstva a Čitateľnosť; farby, polomery a krivky sa pri každom renderovaní čítajú z premenných v :root súboru css (posledná hodnota platí)",
  "css": "assets/style.css",
