    "--p-text-vaha": "400",
    "--p-riadok-vaha": "400",
    "--p-stitok-vaha": "400",
    "--p-stitok-rozostup": "0.18em",
    "--p-vyzva-velkost": "none",
    "--p-vyzva-rozostup": "0.02em",
