+  skus(`${nazov}: DIČ SK1083167855 ostane text, nie odkaz tel:`, /DIČ SK1083167855/.test(fi.text) && !fi.tel.some((t) => /083167855/.test(t)), fi.tel.join(', ') || 'bez tel:');
