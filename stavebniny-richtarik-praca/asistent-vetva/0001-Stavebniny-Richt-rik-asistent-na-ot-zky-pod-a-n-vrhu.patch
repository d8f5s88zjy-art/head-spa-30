+/* STAVEBNINY RICHTÁRIK – okno asistenta (asistent.js), v štýle webu: papier, malta, tmavé písmo, tehlová červená,
+   Barlow a Barlow Condensed (premenné zo site.css). Načíta sa až s modulom, prvý obraz stránky ho nepotrebuje.
+   Ikona (tehlová značka v bielom kruhu so štítkom AI, 52 px, na telefóne 46 px) je vpravo dole; na telefóne nad
+   spodnou lištou Zavolať a Cenová ponuka (.mbar). Okno na počítači vyskočí nad ikonou, na telefóne sa vysunie zdola.
+   Žiadna tmavá plocha: clona za oknom na telefóne je svetlá. */
+.asi-znak { display: grid; place-items: center; border-radius: 50%; background: #fff; color: var(--brick); }
+.asi-znak svg { width: 60%; height: 60%; }
+.asi-ai {
+  display: inline-block; padding: 2px 6px; border-radius: 3px; background: var(--brick); color: #fff;
+  font: 700 11px/1.25 var(--body); letter-spacing: .06em; vertical-align: middle;
+}
+:root { --asi-dole: 20px; }
+@media (max-width: 980px) { :root { --asi-dole: 84px; } }   /* nad spodnou lištou .mbar (site.css, do 980 px) */
+
+/* ikona */
+.asi-btn {
+  position: fixed; right: var(--gutter); bottom: calc(var(--asi-dole) + env(safe-area-inset-bottom, 0px)); z-index: 45;
+  width: 52px; height: 52px; padding: 0; display: grid; place-items: center;
+  border: 2px solid var(--brick); border-radius: 50%; background: #fff; cursor: pointer;
+  box-shadow: 0 8px 22px rgba(20, 18, 16, .18);
+  opacity: 0; transform: translateY(12px); transition: opacity .4s ease, transform .4s ease;
+}
+.asi-btn.is-on { opacity: 1; transform: none; }
+.asi-btn:active { transform: scale(.96); }
+.asi-btn .asi-znak-btn { width: 100%; height: 100%; transition: opacity .15s; }
+.asi-btn .asi-ai { position: absolute; top: -6px; right: -8px; padding: 1px 4px; font-size: 10px; box-shadow: 0 0 0 2px #fff; }
+.asi-btn > svg { position: absolute; width: 22px; height: 22px; color: var(--ink); opacity: 0; transition: opacity .15s; }
+html.asi-open .asi-btn .asi-znak-btn { opacity: 0; }
+html.asi-open .asi-btn > svg { opacity: 1; }
+.asi-btn:focus-visible, .asi-oznam :focus-visible, .asi-panel :focus-visible { outline: 3px solid var(--brick); outline-offset: 2px; }
+/* otvorené menu alebo lightbox: ikona ani bublina nezavadzajú */
+body:has(#drawer.open, .lb:not([hidden])) .asi-btn,
+body:has(#drawer.open, .lb:not([hidden])) .asi-oznam { opacity: 0; pointer-events: none; }
+
+/* úvod s vlastnými tlačidlami v okne (asistent.js, trieda asi-uvod): ikona sa skryje, fokusom z klávesnice sa ukáže */
+html.asi-uvod:not(.asi-open) .asi-btn:not(:focus-visible) { opacity: 0; pointer-events: none; transform: translateY(12px); }
+html.asi-uvod .asi-oznam { display: none; }
+
+/* bublina pri ikone: Opýtať sa, Zavolať, zavrieť */
+.asi-oznam {
+  position: fixed; right: var(--gutter); bottom: calc(var(--asi-dole) + 64px + env(safe-area-inset-bottom, 0px)); z-index: 46;
+  width: min(300px, calc(100vw - 2 * var(--gutter))); padding: 10px 10px 12px 14px;
+  border: 1px solid var(--line); border-radius: 6px; border-bottom-right-radius: 2px; background: #fff; color: var(--ink);
+  font: 400 15px/1.45 var(--body); box-shadow: 0 16px 40px rgba(20, 18, 16, .16);
+  opacity: 0; transform: translateY(10px); transform-origin: 100% 100%; transition: opacity .35s ease, transform .35s ease;
+}
+.asi-oznam[hidden] { display: none; }
+.asi-oznam.is-on { opacity: 1; transform: none; }
+.asi-oznam-hlava { display: flex; align-items: center; gap: 10px; }
+.asi-znak-s { flex: none; width: 30px; height: 30px; border: 1.5px solid var(--brick); }
+.asi-oznam-h { flex: 1; margin: 0; font: 700 18px/1.1 var(--display); text-transform: uppercase; letter-spacing: .02em; }
+.asi-oznam-h .asi-ai, .asi-hlava h2 .asi-ai { margin-left: 6px; position: relative; top: -2px; }
+.asi-oznam-x { flex: none; width: 40px; height: 40px; margin: -6px -4px -6px 0; display: grid; place-items: center; border: 0; background: none; color: var(--ink-3); cursor: pointer; }
+.asi-oznam-x svg { width: 18px; height: 18px; }
+.asi-oznam-t { margin: 6px 0 10px; }
+.asi-oznam-akcie { display: flex; gap: 8px; }
+.asi-oznam-spytaj, .asi-oznam-tel { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 0 12px; border-radius: var(--radius); font: 700 15px/1 var(--display); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; cursor: pointer; }
+.asi-oznam-spytaj { border: 0; background: var(--brick); color: #fff; }
+.asi-oznam-tel { border: 1.5px solid var(--ink); color: var(--ink); }
+.asi-oznam-tel svg { width: 18px; height: 18px; }
+
+/* okno */
+.asi-panel {
+  position: fixed; right: var(--gutter); bottom: calc(var(--asi-dole) + 66px + env(safe-area-inset-bottom, 0px)); z-index: 75;
+  display: flex; flex-direction: column; width: min(410px, calc(100vw - 2 * var(--gutter))); height: min(620px, calc(100vh - 150px));
+  border: 1px solid var(--line); border-top: 4px solid var(--brick); border-radius: 6px; background: var(--paper); color: var(--ink);
+  font: 400 16px/1.5 var(--body); box-shadow: 0 30px 70px rgba(20, 18, 16, .22); overflow: hidden;
+  transform-origin: 100% 100%; animation: asi-in .3s ease;
+}
+.asi-panel[hidden] { display: none; }
+@keyframes asi-in { from { opacity: 0; transform: translateY(12px); } }
+.asi-hlava { display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 16px; background: #fff; border-bottom: 1px solid var(--line); }
+.asi-znak-m { flex: none; width: 44px; height: 44px; border: 2px solid var(--brick); }
+.asi-hlava-t { flex: 1; min-width: 0; }
+.asi-hlava h2 { margin: 0; font: 800 24px/1 var(--display); text-transform: uppercase; letter-spacing: .01em; }
+.asi-sub { margin: 3px 0 0; color: var(--ink-3); font-size: 13px; line-height: 1.3; max-width: none; }
+.asi-hlava-akcie { flex: none; display: flex; align-items: center; gap: 8px; }
