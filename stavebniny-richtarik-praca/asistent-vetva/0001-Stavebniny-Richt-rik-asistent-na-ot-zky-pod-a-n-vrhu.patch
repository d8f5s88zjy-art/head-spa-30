diff --git a/stavebniny-richtarik/asistent/web.config b/stavebniny-richtarik/asistent/web.config
new file mode 100644
index 00000000..e9dee663
--- /dev/null
+++ b/stavebniny-richtarik/asistent/web.config
@@ -0,0 +1,36 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- ASISTENT STAVEBNÍN RICHTÁRIK – IIS (dnešný hosting je IIS 10). Zvonku je dostupné len api.php a ochrana-udajov.html;
+     priečinky lib, data, znalosti, vendor, testy a súbory config*.php, composer.*, README.md sú skryté (404).
+     PHP cez FastCGI: odpoveď ide po kúskoch len s responseBufferLimit="0" na obsluhe PHP (nastaví hosting,
+     handler sa na zdieľanom hostingu často nedá zmeniť v web.config – otázka pre hosting, ZAPIS.md). -->
+<configuration>
+  <system.webServer>
+    <security>
+      <requestFiltering>
+        <hiddenSegments>
+          <add segment="lib" />
+          <add segment="data" />
+          <add segment="znalosti" />
+          <add segment="vendor" />
+          <add segment="testy" />
+        </hiddenSegments>
+        <denyUrlSequences>
+          <add sequence="config.php" />
+          <add sequence="config.example.php" />
+          <add sequence="composer." />
+          <add sequence="README.md" />
+        </denyUrlSequences>
+      </requestFiltering>
+    </security>
+    <defaultDocument enabled="false" />
+    <directoryBrowse enabled="false" />
+    <!-- prúd udalostí nesmie čakať na kompresiu celej odpovede -->
+    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
+    <httpProtocol>
+      <customHeaders>
+        <add name="X-Content-Type-Options" value="nosniff" />
+        <add name="X-Robots-Tag" value="noindex, nofollow" />
+      </customHeaders>
+    </httpProtocol>
+  </system.webServer>
+</configuration>
