+skus "pokyny: AI asistent, nie človek; ceny nevymýšľa; vykanie" 'echo "$J" | grep -q "Si AI asistent na webe Stavebniny Richtárik" && echo "$J" | grep -q "nie človek" && echo "$J" | grep -q "Ceny nikdy nepočítaj" && echo "$J" | grep -q "vykaj"'
