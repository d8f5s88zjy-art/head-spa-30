diff --git a/stavebniny-richtarik/asistent/README.md b/stavebniny-richtarik/asistent/README.md
new file mode 100644
index 00000000..9e4964d6
--- /dev/null
+++ b/stavebniny-richtarik/asistent/README.md
@@ -0,0 +1,52 @@
+# Asistent na otázky (Stavebniny Richtárik)
+
+Okno „Asistent“ na webe Stavebniny Richtárik, vo všetkých textoch okna zreteľne označené štítkom AI (rovnako ako Barber
+na webe Barbershop 30): návštevník napíše otázku alebo ťukne na častú otázku a odpoveď sa píše hneď, po kúskoch.
+Naostro odpovedá model Claude Opus 5.5 (oficiálna PHP knižnica Anthropic) len z overených údajov webu. Nezávislý od
+Barbershopu: vlastný server v tomto priečinku, vlastná doména, vlastný kľúč a účet majiteľa.
+
+| Časť | Kde |
+| --- | --- |
+| Okno na webe (ikona, bublina, témy a časté otázky, odkazy v odpovedi, rozhovor v karte prehliadača) | `assets/asistent.js`, `asistent.css` |
+| Časté otázky v prehliadači a hľadanie | `assets/asistent-otazky.js`, `assets/asistent-otazky.json` (kópia zdroja) |
+| Ukážka bez servera (náhľad) | `assets/asistent-ukazka.js` |
+| Zapnutie (atribút `data-asistent` na `<html>`) | `assets/site.js` (časť asistent), `build.py`, `index.html`, `nasadenie/balik.sh` |
+| Server: prúd odpovede, limity, kontrola vstupu | `api.php`, `lib/jadro.php` |
+| Časté otázky na serveri (to isté hľadanie) | `lib/otazky.php` |
+| Čo asistent vie (jediný zdroj faktov) | `znalosti/richtarik.md`, `znalosti/richtarik-otazky.json` (60 overených odpovedí) |
+| Ochrana údajov (odkaz z okna) | `ochrana-udajov.html` |
+| Apache / IIS (zvonku len `api.php` a `ochrana-udajov.html`) | `.htaccess`, `lib/.htaccess`, `data/.htaccess`, `web.config` |
+| Konfigurácia s kľúčom (mimo repozitára) | `config.example.php`, `nasadenie/asistent-config.php` |
+| Testy a nástroje (do balíka nejdú) | `testy/spusti.sh` (server proti falošnému API, 27 kontrol), `nastroje/otazky_zdroj.py` (zdroj častých otázok), `nastroje/otazky.mjs` (fakty a hľadanie), `nastroje/prehliadac.mjs` (okno v prehliadači) |
+
+## Zapnutie
+- Náhľad: `data-asistent="ukazka"` na `<html>` všetkých stránok (build.py, index.html). Okno ukazuje vopred pripravené
+  overené odpovede, pás v okne hovorí, že nepíše AI a nič sa neposiela.
+- Ostrý web bez servera: `bash nasadenie/balik.sh . <výstup>` atribút odstráni, okno sa neukáže, nič sa nesťahuje.
+- Ostrý web so serverom (keď hosting spĺňa podmienky nižšie a majiteľ má kľúč):
+  1. `ASISTENT_API=https://www.stavebninyrichtarik.sk/asistent/api.php bash nasadenie/balik.sh . <výstup>`
+  2. `composer install -d <výstup>/web/asistent --no-dev --prefer-dist --optimize-autoloader`
+  3. `KLUC=… php nasadenie/asistent-config.php > <výstup>/web/asistent/config.php` (kľúč len v premennej prostredia)
+  4. nahrať, `asistent/data/` zapisovateľný pre PHP; kontrola `https://www.stavebninyrichtarik.sk/asistent/api.php?a=stav`
+     vráti `"zapnute":true` a `…/asistent/lib/jadro.php`, `…/asistent/znalosti/richtarik.md`, `…/asistent/config.php`
+     vrátia 403 alebo 404.
+- `?asistent=off` okno vypne, `?asistent=ukazka` ukáže ukážku, na localhost `?asistent=<adresa>` skúšobný server.
+
+## Hosting
+PHP 8.1 alebo novšie (odporúčané 8.3) s rozšíreniami pdo_sqlite, curl, mbstring, openssl, json; HTTPS s platným
+certifikátom; zapisovateľný `asistent/data/`; výstup bez vyrovnávania (Apache: `no-gzip`, IIS FastCGI:
+`responseBufferLimit="0"` na obsluhe PHP), odchádzajúce HTTPS na api.anthropic.com.
+
+## Ako to funguje
+- Prehliadač pošle rozhovor (najviac 16 správ, otázka najviac 800 znakov) na `api.php?a=otazka`. Server pridá pokyny
+  a znalosti (v cache API), k poslednej otázke najviac 6 podobných overených odpovedí (mimo cache) a posiela text ďalej
+  ako `text/event-stream`. Úsilie `low`, záložný model `fallbacks: "default"`. Žiadne nástroje.
+- Limity: 12 otázok za 10 minút a 40 za deň od návštevníka (IP len ako odtlačok so soľou, po 24 h preč), 400 otázok za
+  deň spolu (strop nákladov). Rozhovory sa na serveri neukladajú.
+- Ceny len tie, ktoré sú v znalostiach (cenník akcií 28. 1. 2026), vždy s tým, že platnosť potvrdí predajňa; nič
+  nepočíta (cena, množstvo), skladovú zásobu ani termín dovozu nesľubuje. Na otázku, kto odpovedá, povie pravdivo, že je
+  AI asistent webu, nie človek.
+
+## Keď sa zmení akcia, cenník, hodiny alebo kontakt
+Zmeniť `znalosti/richtarik.md` a `nastroje/otazky_zdroj.py`, vyrobiť `znalosti/richtarik-otazky.json`, skopírovať ho do
+`assets/asistent-otazky.json` a spustiť `node asistent/nastroje/otazky.mjs .` (musí byť 0 FAIL okrem známych hraníc).
diff --git a/stavebniny-richtarik/asistent/api.php b/stavebniny-richtarik/asistent/api.php
new file mode 100644
index 00000000..716505e1
--- /dev/null
+++ b/stavebniny-richtarik/asistent/api.php
@@ -0,0 +1,100 @@
+<?php
+/* ASISTENT STAVEBNÍN RICHTÁRIK – odpovede na otázky návštevníkov webu (model Claude Opus 5.5 cez oficiálnu knižnicu
+ * Anthropic pre PHP). Prevzaté z Barbershopu 30 (asistent/api.php) bez rezervačného kalendára a bez nástrojov.
+ *   GET  api.php?a=stav    -> {"ok":true,"zapnute":bool}  (okno na webe sa ukáže, len keď je zapnuté)
+ *   POST api.php?a=otazka  telo {"prevadzka":"richtarik","spravy":[{"r":"u","t":"…"},…]}
+ *        -> text/event-stream: udalosti "text" {"t":"…"}, "tel" {} (pod odpoveď patrí Zavolať), na konci "koniec" {},
+ *           pri chybe "chyba" {"chyba":"…"}
+ * Kľúč API je len v config.php na serveri (mimo repozitára), nikdy v prehliadači. Rozhovory sa neukladajú. */
+declare(strict_types=1);
+const ASISTENT = true;
+require __DIR__ . '/lib/jadro.php';
+require __DIR__ . '/lib/otazky.php';
+
+header('X-Content-Type-Options: nosniff');
+header('Referrer-Policy: no-referrer');
+header('X-Robots-Tag: noindex, nofollow');
+cors();
+$o = (string) ($_SERVER['HTTP_ORIGIN'] ?? '');
+if ($o !== '' && !povod_povoleny($o)) chyba('Zakázaný pôvod.', 403);
+$a = (string) ($_GET['a'] ?? '');
+$post = ($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST';
+
+// zapnutý = kľúč, knižnica aj PHP aspoň 8.1 (knižnica Anthropic staršie PHP nespustí)
+if ($a === 'stav') odpoved(['ok' => true, 'zapnute' => kluc_api() !== '' && is_file(__DIR__ . '/vendor/autoload.php') && PHP_VERSION_ID >= 80100]);
+if ($a !== 'otazka') chyba('Neznáma akcia.', 404);
+if (!$post) chyba('POST', 405);
+if (!str_starts_with((string) ($_SERVER['CONTENT_TYPE'] ?? ''), 'application/json')) chyba('Očakávam JSON.', 415);
+if (kluc_api() === '' || !is_file(__DIR__ . '/vendor/autoload.php')) chyba('Asistent je vypnutý.', 503);
+
+$v = vstup();
+$prevadzka = (string) ($v['prevadzka'] ?? '');
+if (!isset(PREVADZKY[$prevadzka])) chyba('Neznáma prevádzka.');
+$spravy = rozhovor($v['spravy'] ?? null);
+if (!limit_ok()) chyba('Veľa otázok naraz. Skúste to o chvíľu alebo zavolajte na 0905 622 223.', 429);
+
+require __DIR__ . '/vendor/autoload.php';
+
+use Anthropic\Beta\Messages\BetaRawContentBlockDeltaEvent;
+use Anthropic\Beta\Messages\BetaTextDelta;
+use Anthropic\Client;
+use Anthropic\Core\Exceptions\APIConnectionException;
+use Anthropic\Core\Exceptions\APIStatusException;
+use Anthropic\Core\Exceptions\RateLimitException;
+use Anthropic\Lib\Streaming\MessageAccumulator;
+
+/* odpoveď ide po kúskoch hneď, ako ich model napíše (bez vyrovnávania v PHP, Apache ani IIS) */
+ignore_user_abort(false);
+@ini_set('zlib.output_compression', '0');
+@ini_set('output_buffering', '0');
+while (ob_get_level() > 0) ob_end_clean();
+header('Content-Type: text/event-stream; charset=utf-8');
+header('Cache-Control: no-store');
+header('X-Accel-Buffering: no');
+function udalost(string $meno, array $data): void {
+  echo "event: $meno\ndata: " . json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n\n";
+  flush();
+}
+echo ':' . str_repeat(' ', 2048) . "\n\n"; flush();   // niektoré proxy pošlú prvé bajty až po 2 kB
+
+$k = konfig();
+$zly = 'Teraz neviem odpovedať. Zavolajte nám na 0905 622 223 (pondelok až piatok 7:00 až 16:00, sobota 7:00 až 12:00).';
+$otazka = (string) end($spravy)['content'];
+// overené odpovede na podobné časté otázky (lib/otazky.php), mimo časti v cache
+$caste = otazky_pre_model($prevadzka, $otazka);
+try {
+  $client = new Client(apiKey: kluc_api(), requestOptions: ['maxRetries' => 1, 'timeout' => 60.0]);
+  $stream = $client->beta->messages->createStream(
+    model: (string) ($k['model'] ?? 'claude-opus-5-5'),
+    maxTokens: 4000,
+    system: [
+      // pokyny a znalosti sa nemenia: vyrovnávacia pamäť na strane API (lacnejšie a rýchlejšie ďalšie otázky)
+      ['type' => 'text', 'text' => pokyny($prevadzka), 'cacheControl' => ['type' => 'ephemeral']],
+      ['type' => 'text', 'text' => dnes_text() . ($caste !== '' ? "\n\n$caste" : '')],
+    ],
+    messages: $spravy,
+    // krátke odpovede na otázky o firme: nízke úsilie stačí a odpoveď príde rýchlo (config.php 'usilie')
+    outputConfig: ['effort' => (string) ($k['usilie'] ?? 'low')],
+    fallbacks: 'default',
+    betas: ['server-side-fallback-2026-07-01'],
+  );
+  $acc = MessageAccumulator::forBetaMessages();
+  $text = '';
+  foreach ($stream as $e) {
+    if (connection_aborted()) exit;
+    $acc->accumulate($e);
+    if ($e instanceof BetaRawContentBlockDeltaEvent && $e->delta instanceof BetaTextDelta) { $text .= $e->delta->text; udalost('text', ['t' => $e->delta->text]); }
+  }
+  if ($acc->message()->stopReason === 'refusal') { udalost('chyba', ['chyba' => 'Na toto neodpoviem. So Stavebninami Richtárik vám rád pomôžem.']); exit; }
+  if (treba_volat($otazka) || treba_volat($text)) udalost('tel', []);
+  udalost('koniec', []);
+} catch (RateLimitException $e) {
+  error_log('asistent: limit API ' . $e->getMessage());
+  udalost('chyba', ['chyba' => $zly]);
+} catch (APIStatusException $e) {
+  error_log('asistent: API ' . $e->getMessage());
+  udalost('chyba', ['chyba' => $zly]);
+} catch (APIConnectionException $e) {
+  error_log('asistent: spojenie ' . $e->getMessage());
+  udalost('chyba', ['chyba' => $zly]);
+}
