 =?UTF-8?q?a=20na=C4=8D=C3=ADta=20a=C5=BE=20po=20strihu=20=C3=BAvodu=20a?=
 =?UTF-8?q?=20v=20ne=C4=8Dinnom=20=C4=8Dase?=
