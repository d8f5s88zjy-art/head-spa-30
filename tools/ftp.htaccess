# HEAD SPA 30: nastavenia pre bežný hosting s Apache (napr. Forpsi)

# vlastná stránka pri neexistujúcej adrese
ErrorDocument 404 /404.html

# typy súborov, ktoré staršie servery nepoznajú
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pozor: Forpsi sám presmerúva headspa30.sk na www.headspa30.sk. Pravidlo www -> bez www
  # tu preto byť nesmie, s ich presmerovaním by sa naháňalo dokola (Safari: príliš veľa presmerovaní).
  # https: zapni odstránením # na dvoch riadkoch nižšie, AŽ keď má doména na hostingu SSL certifikát
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# admin sa nemá objaviť vo vyhľadávačoch
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/admin/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# kompresia textových súborov
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# ako dlho si prehliadač pamätá súbory
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 10 minutes"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
