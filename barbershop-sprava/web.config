<?xml version="1.0" encoding="UTF-8"?>
<!-- Správa webu Barbershop 30 na IIS: jadro, obrazovky, semeno a nastavenie PHP sú z webu zakázané. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.php" /><add value="index.html" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="jadro" /><add segment="obrazovky" /><add segment="semeno" /><add segment="testy" /><add segment=".user.ini" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol><customHeaders><add name="X-Robots-Tag" value="noindex, nofollow" /><add name="X-Content-Type-Options" value="nosniff" /><add name="X-Frame-Options" value="DENY" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
