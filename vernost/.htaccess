# VERNOSTNÁ KARTA 30 – Apache. Do knižnice, dát, relácií a konfigurácie sa zvonku nedá dostať.
# Len mod_rewrite a mod_headers (fungujú aj v koreňovom .htaccess webu); Options ani Require vo FilesMatch tu nie sú,
# lebo pri obmedzenom AllowOverride by zhodili celý priečinok na chybu 500.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|data|testy)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.example\.php|README\.md)$ - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|db)$ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  # stránky a skripty kartičky a adminu sa po nasadení hneď obnovia (prehliadač sa len opýta, či sa zmenili)
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "\.(html|js|css)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
