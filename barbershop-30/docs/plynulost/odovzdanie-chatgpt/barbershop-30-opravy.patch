+#!/usr/bin/env node
+import { readFile, writeFile } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createHash } from 'node:crypto';
+
+export function validateCatalog(catalog, sources) {
+  if (!Array.isArray(catalog.nodes) || catalog.nodes.length !== 20 || !Array.isArray(catalog.researchers) || catalog.researchers.length !== 20) throw new Error('Katalóg musí mať 20 úplných dvojíc.');
+  const ids = new Set(catalog.nodes.map(n => n.id));
+  const researchIds = new Set(catalog.researchers.map(r => r.id));
+  const sourceIds = new Set((sources.sources || []).map(s => s.id));
+  if(ids.size !== 20 || researchIds.size !== 20) throw new Error('ID dvojíc sa opakujú.');
+  for (let i=1;i<=20;i++) {
+    const suffix=String(i).padStart(2,'0'),node=catalog.nodes.find(n=>n.id==='N'+suffix),researcher=catalog.researchers.find(r=>r.id==='R'+suffix);
+    if(!node?.title || node.researcher_id!==researcher?.id || researcher?.parent_node_id!==node.id) throw new Error('Neúplné párovanie N'+suffix+'.');
+    if(!(node.requires||[]).every(id=>ids.has(id)) || !(researcher.source_ids||[]).every(id=>sourceIds.has(id))) throw new Error('Neznáma závislosť alebo zdroj pri '+node.id+'.');
+  }
+  return {catalog,sources};
+}
+export function embed(template,data){
+  if(!template.includes('/*KATALOG*/null'))throw new Error('Šablóna nemá miesto pre katalóg.');
+  return template.replace('/*KATALOG*/null',JSON.stringify(data).replaceAll('<','\\u003c').replaceAll('\u2028','\\u2028').replaceAll('\u2029','\\u2029'));
+}
+if(process.argv[1] && resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+  try{
+    const dir=dirname(fileURLToPath(import.meta.url));
+    const [catalogPath,sourcesPath,outputPath=resolve(dir,'brain.html')]=process.argv.slice(2);
+    if(!catalogPath||!sourcesPath)throw new Error('Použi: node render-brain.mjs KATALÓG_JSON ZDROJE_JSON [VÝSTUP_HTML]');
+    const catalogText=await readFile(resolve(catalogPath),'utf8'),sourceText=await readFile(resolve(sourcesPath),'utf8');
+    const data=validateCatalog(JSON.parse(catalogText),JSON.parse(sourceText));
+    data.exportedAt=new Date().toISOString();data.catalogHash=createHash('sha256').update(catalogText).digest('hex');
+    const html=embed(await readFile(resolve(dir,'brain-template.html'),'utf8'),data);
+    await writeFile(resolve(outputPath),html);
+    console.log(JSON.stringify({page:resolve(outputPath),pairs:data.catalog.nodes.length,sources:data.sources.sources.length,catalogHash:data.catalogHash,exportedAt:data.exportedAt},null,2));
+  }catch(error){console.error('Zastavené: '+error.message);process.exitCode=1;}
+}
