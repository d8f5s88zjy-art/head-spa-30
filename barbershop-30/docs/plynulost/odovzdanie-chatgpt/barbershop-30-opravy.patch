ed);font-weight:400}.node[aria-pressed=true]{border-color:var(--dark);background:var(--dark);color:#fff6e7}.node[aria-pressed=true] span{color:#e3d4be}.node.core{width:116px;border-color:var(--gold)}.map-note{font-size:12px;color:var(--muted);max-width:620px}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--muted)}.legend span:before{content:'';display:inline-block;width:18px;border-top:1px solid #a48d6b;vertical-align:middle;margin-right:6px}.legend span:last-child:before{border-top-style:dashed}aside{padding:26px 0 28px 28px;border-left:1px solid var(--line);min-width:0}.detail-sub{font-size:13px;color:var(--muted)}.fact{display:grid;grid-template-columns:85px 1fr;gap:12px;font-size:12px;padding:10px 0;border-bottom:1px solid var(--line)}.fact dt{color:var(--muted)}.fact dd{margin:0;overflow-wrap:anywhere}ul{padding-left:18px;margin:6px 0}li{margin:4px 0}.paths{font:11px/1.7 ui-monospace,monospace;overflow-wrap:anywhere;max-height:175px;overflow:auto;padding:10px 12px;list-style:none;background:#eee8de}.small{font-size:12px}.notice{border-left:2px solid var(--gold);padding:10px 13px;font-size:12px;background:#efe7d8}.empty{color:var(--muted);font-size:13px}.tasks{margin-top:32px}.task-row{display:grid;grid-template-columns:120px minmax(200px,1fr) 140px 160px;gap:16px;align-items:start;padding:16px 0;border-bottom:1px solid var(--line);font-size:13px}.task-row button{border:0;background:transparent;text-align:left;padding:0;color:var(--ink)}.task-row button:hover{text-decoration:underline}.task-row .id{font:12px ui-monospace,monospace;color:var(--gold)}footer{display:flex;justify-content:space-between;gap:24px;margin-top:24px;font-size:12px;color:var(--muted)}code{font:11px ui-monospace,monospace;overflow-wrap:anywhere}.limits{margin-top:16px}.limits summary{cursor:pointer}#paused{color:var(--red)}@media(max-width:1000px){main{padding:28px 24px}.workspace{grid-template-columns:minmax(0,1fr) 310px}.brain{height:480px}.node{width:94px;font-size:13px}.node.core{width:98px}.task-row{grid-template-columns:90px 1fr 110px}.task-row>span:last-child{display:none}}@media(max-width:760px){header{display:block}.stamp{text-align:left;margin-top:20px;max-width:none}.workspace{grid-template-columns:1fr}.map-wrap{padding:10px 0 18px}.brain{height:440px}aside{border-left:0;border-top:1px solid var(--line);padding:24px 0}.task-row{grid-template-columns:80px 1fr}.task-row>span:nth-last-child(2){grid-column:2}.node{width:90px}footer{display:block}h1{font-size:38px}}@media(max-width:390px){main{padding:22px 14px}.node{width:80px;font-size:12px}.node.core{width:86px}.node span{font-size:10px}.brain{height:420px}}
+</style>
