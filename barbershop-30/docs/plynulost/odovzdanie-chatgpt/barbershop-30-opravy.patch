diff --git a/barbershop-30/assets/film-worker.js b/barbershop-30/assets/film-worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..e8404c41b11c49ace04fd2b0ed4cc63bf6173a8b
--- /dev/null
+++ b/barbershop-30/assets/film-worker.js
@@ -0,0 +1,30 @@
+/* Rozbalenie skutočných fotiek mimo hlavného vlákna. Do grafiky putujú hotové riadky RGBA. */
+'use strict';
+const tasks = new Map();
+let supported = false;
+try { supported = !!new OffscreenCanvas(1, 1).getContext('2d', { willReadFrequently: true }); } catch (error) { /* Starší prehliadač použije hlavný dekodér. */ }
+self.postMessage({ supported });
+self.onmessage = async ({ data: job }) => {
+  if (job.cancel) { tasks.get(job.id)?.abort(); return; }
+  const ctl = new AbortController(); tasks.set(job.id, ctl);
+  let bitmap;
+  try {
+    let blob = job.blob;
+    if (!blob) {
+      const response = await fetch(job.url, { signal: ctl.signal });
+      if (!response.ok) throw new Error('Fotka sa nenačítala: ' + response.status);
+      blob = await response.blob();
+    }
+    bitmap = await createImageBitmap(blob);
+    if (ctl.signal.aborted) return;
+    const width = bitmap.width, height = bitmap.height;
+    const canvas = new OffscreenCanvas(width, height);
+    const context = canvas.getContext('2d', { willReadFrequently: true, colorSpace: 'srgb' });
+    if (!context) throw new Error('Rozbalenie fotky nie je dostupné');
+    context.drawImage(bitmap, 0, 0);
+    const pixels = context.getImageData(0, 0, width, height);
+    if (!ctl.signal.aborted) self.postMessage({ id: job.id, width, height, buffer: pixels.data.buffer }, [pixels.data.buffer]);
+  } catch (error) {
+    if (!ctl.signal.aborted) self.postMessage({ id: job.id, error: error.message });
+  } finally { bitmap?.close(); tasks.delete(job.id); }
+};
