+/* BARBERSHOP 30 – pripravená fotografia a jej popis sa menia spoločne. */
+const wrap = (value, length) => (value % length + length) % length;
+
+// Vlastní iba svoje obrázky: aktuálny a najviac dva susedné, počas výmeny starý a nový.
+export function photoFlow({ count, makeImage, commit, busy, failed, reduced,
+  schedule = requestAnimationFrame, cancel = cancelAnimationFrame }) {
+  const images = new Map();
+  let version = 0, requested = -1, current = null, outgoing = null, animation = null, raf = 0, active = false;
+  const release = (entry) => {
+    if (!entry) return;
+    entry.image.remove(); entry.image.removeAttribute('srcset'); entry.image.removeAttribute('src');
+    if (images.get(entry.index) === entry) images.delete(entry.index);
+  };
+  function finish() {
+    const previous = animation; animation = null; previous?.forEach((effect) => effect.cancel());
+    if (current) current.image.style.opacity = '1';
+    release(outgoing); outgoing = null;
+  }
+  function get(index) {
+    if (images.has(index)) return images.get(index);
+    const image = makeImage(index), entry = { index, image, loaded: null };
+    entry.loaded = typeof image.decode === 'function' ? image.decode() : new Promise((resolve, reject) => {
+      if (image.complete) { image.naturalWidth ? resolve() : reject(new Error('Fotografia nie je dostupná')); return; }
+      image.onload = resolve; image.onerror = reject;
+    });
+    entry.loaded.catch(() => {}); images.set(index, entry); return entry;
+  }
+  function neighbors() {
+    if (!active || !current || outgoing) return;
+    const keep = new Set([current.index, wrap(current.index - 1, count), wrap(current.index + 1, count)]);
+    for (const entry of images.values()) if (!keep.has(entry.index)) release(entry);
+    for (const index of keep) if (index !== current.index) {
+      const entry = get(index);
+      entry.loaded.catch(() => { if (entry !== current && entry !== outgoing) release(entry); });
+    }
+  }
+  async function show(index) {
+    active = true; const ticket = ++version; requested = wrap(index, count);
+    if (raf) cancel(raf); raf = 0; finish();
+    for (const entry of images.values()) if (entry !== current && entry.index !== requested) release(entry);
+    if (current?.index === requested) { busy(false); neighbors(); return; }
+    busy(true);
+    const entry = get(requested);
+    try {
+      await entry.loaded;
+      // Prehliadač môže dekódované dáta suseda medzičasom uvoľniť: potvrdiť ten istý prvok znova.
+      if (!active || version !== ticket) return;
+      if (typeof entry.image.decode === 'function') await entry.image.decode();
+      if (!active || version !== ticket) return;
+      raf = schedule(() => {
+        raf = 0;
+        if (!active || version !== ticket) return;
+        outgoing = current; current = entry;
+        commit(entry, outgoing); busy(false);
+        if (!outgoing || reduced() || typeof entry.image.animate !== 'function' || typeof outgoing.image.animate !== 'function') { finish(); neighbors(); return; }
