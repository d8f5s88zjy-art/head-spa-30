+#!/usr/bin/env node
+// Regresie D2/D5: náhľady, okamžité kotvy, pomalé fotky, pokojné karty a nastavenia.
+// node source/tools/frontend-regression.mjs [--assets-only]
+// Prehliadač musí byť v prostredí pripravený; tento test ho nesťahuje.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
