@@ -0,0 +1,19 @@
+/* Právne znenie ostáva slovenské; prekladá sa iba upozornenie a zachová sa jazyk návratu. */
+let language = new URLSearchParams(location.search).get('lang');
+if (!language) {
+  try { language = localStorage.getItem('b30.lang'); } catch { /* súkromné okno */ }
+}
+if (/^(en|uk|hu|sr|pl|de|cs)$/.test(language || '')) {
+  const note = document.querySelector('[data-legal-language]');
+  const back = document.querySelector('[data-legal-back]');
+  if (back) back.setAttribute('href', './?lang=' + language);
+  if (note) {
+    note.hidden = false;
+    fetch(new URL('i18n/' + language + '.json', import.meta.url), { cache: 'force-cache' })
+      .then((response) => { if (!response.ok) throw new Error('Preklad nie je dostupný'); return response.json(); })
+      .then((dictionary) => {
+        const text = dictionary['Právne informácie sú po slovensky.'];
+        if (typeof text === 'string' && text.trim()) { note.textContent = text; note.lang = language; }
+      }).catch(() => { /* slovenská informácia ostáva čitateľná aj bez siete */ });
+  }
+}
