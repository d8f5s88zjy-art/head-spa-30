@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+// Skutočný Chromium: náhľady pri blokovaných fotkách, skoky, strata/obnova kontextu a ukončenie.
+// NODE_PATH=<dostupné moduly> node source/tools/film-continuity.mjs --url=http://127.0.0.1:8100/
+// --out=<priečinok> uloží snímky a výsledok. --executable=<už nainštalovaný Chromium> je voliteľný.
+// Softvérová grafika neoveruje cieľové fps/INP ani mobilný GPU čas.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+const { PNG } = require('pngjs');
+const options = Object.fromEntries(process.argv.slice(2).map((value) => value.replace(/^--/, '').split('=')));
+if (!options.url) throw new Error('Zadaj --url lokálneho servera na porte 8100–8999.');
+const output = path.resolve(options.out || '/tmp/bs30-film-continuity');
+fs.mkdirSync(output, { recursive: true });
+const browser = await chromium.launch({ headless: true, executablePath: options.executable,
+  args: ['--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--ignore-gpu-blocklist'] });
+const results = [];
+try {
+  for (const [name, viewport, dpr] of [['desktop', { width: 1440, height: 900 }, 1], ['mobile', { width: 390, height: 844 }, 3]]) {
+    const context = await browser.newContext({ viewport, deviceScaleFactor: dpr, isMobile: name === 'mobile', hasTouch: name === 'mobile' });
+    const page = await context.newPage(), errors = [];
+    page.on('pageerror', (error) => errors.push(error.message));
+    // Malé náhľady ostanú dostupné; ostré obrazy cieľov zámerne nemôžu prísť.
+    await page.route(/\/assets\/img\/film\/.*(?:-\d+\.(?:avif|webp)|-hlbka-z\.webp)$/, (route) => route.abort());
+    await page.goto(new URL('index.html?uvod=off&film=on', options.url).href);
+    await page.mouse.move(20, 20);
+    await page.waitForFunction(() => window.BS30_FILM?.state.shown, null, { timeout: 30000 });
+    for (const id of ['kontakt', 'sluzby', 'uvod']) {
+      const moved = await page.evaluate((targetId) => {
+        const target = document.getElementById(targetId);
+        if (!target) return false;
+        target.scrollIntoView({ behavior: 'instant' });
+        dispatchEvent(new CustomEvent('bs30:skok', { detail: { id: targetId, y: scrollY } }));
+        return true;
+      }, id);
+      assert.ok(moved, `Kotva ${id} existuje`);
+      await page.waitForFunction(() => !window.BS30_FILM.position.moving);
+    }
+    const before = await page.evaluate(() => window.BS30_FILM.state.frames);
+    await page.waitForFunction((frame) => window.BS30_FILM.state.frames > frame + 2, before);
+    const buffer = await page.locator('.film-canvas').screenshot({ path: path.join(output, `${name}-nahlad.png`) });
+    const png = PNG.sync.read(buffer); let sum = 0, squares = 0, count = 0;
+    for (let i = 0; i < png.data.length; i += 16) {
+      const value = (png.data[i] + png.data[i + 1] + png.data[i + 2]) / 3;
+      sum += value; squares += value * value; count++;
+    }
+    const deviation = Math.sqrt(squares / count - (sum / count) ** 2);
+    assert.ok(deviation > 4, `${name}: plátno obsahuje obraz, nie jednofarebnú prázdnu plochu`);
+    await page.evaluate(() => {
+      window.__filmLoss = document.querySelector('.film-canvas').getContext('webgl2').getExtension('WEBGL_lose_context');
+      window.__filmLoss.loseContext();
+    });
+    await page.waitForFunction(() => document.documentElement.classList.contains('film-strata'));
+    await page.screenshot({ path: path.join(output, `${name}-strata.png`) });
+    await page.evaluate(() => window.__filmLoss.restoreContext());
+    await page.waitForFunction(() => !document.documentElement.classList.contains('film-strata') && window.BS30_FILM.state.on && !window.BS30_FILM.state.recovering, null, { timeout: 10000 });
+    await page.evaluate(() => window.BS30_FILM.brzdaTest());
+    assert.equal(await page.locator('.film-canvas').count(), 0);
+    assert.equal(await page.evaluate(() => document.documentElement.classList.contains('world-off')), true);
+    assert.deepEqual(errors, []);
+    results.push({ viewport: name, dpr, previewDeviation: deviation, continuity: 'pass', context: 'pass', stop: 'pass', performance: 'not measured' });
+    await context.close();
+  }
+} finally { await browser.close(); }
+fs.writeFileSync(path.join(output, 'result.json'), JSON.stringify(results, null, 2) + '\n');
+console.log(JSON.stringify(results, null, 2));
