+++ b/barbershop-30/assets/navsteva.js
@@ -0,0 +1,113 @@
+/* Praktické informácie sa načítajú až pri kontakte alebo pri odkaze #pred-navstevou.
+   Zdroj a dátum patria ku každej odpovedi; nepotvrdené podmienky sa nevykresľujú. */
+const REZ = 'https://www.barbershop30.sk/rezervacia';
+const WEB = 'https://www.barbershop30.sk/';
+const MESTO = 'https://nitra.sk/parkovanie/';
+export const OTAZKY = [
+  {
+    id: 'objednanie', otazka: 'Ako sa objednám?', kroky: [
+      'Vyber si službu.', 'Vyber si barbera alebo možnosť „Nezáleží“.',
+      'Vyber si voľný termín.', 'Vyplň svoje údaje a potvrď rezerváciu.',
+    ], texty: ['Informácie o rezervácii ti prídu e-mailom.'],
+    odkazy: [['Rezervovať termín', REZ]],
+    zdroj: [REZ, REZ + '/ajax'], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'termin', otazka: 'Kedy sa môžem objednať?',
+    texty: ['Kalendár ponúka termíny na dnes aj mesiac dopredu, podľa dostupnosti.'],
+    odkazy: [['Rezervovať termín', REZ]],
+    zdroj: [REZ + '/ajax'], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'zmena', otazka: 'Ako zmením termín?',
+    texty: ['Ak potrebuješ zmeniť termín, ozvi sa telefonicky alebo e-mailom.'],
+    odkazy: [['Zavolať na recepciu', 'tel:+421951267203'], ['Napísať e-mail', 'mailto:info@barbershop30.sk']],
+    zdroj: [REZ], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'barber', otazka: 'Musím si vybrať barbera?',
+    texty: ['Ak nemáš svojho barbera, v 2. kroku vyber možnosť „Nezáleží“.'],
+    zdroj: [REZ + '/ajax'], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'deti', otazka: 'Striháte aj deti?',
+    texty: ['Strih pre malých gentlemanov je pre chlapcov do 10 rokov. Aktuálnu cenu a trvanie nájdeš v cenníku.'],
+    odkazy: [['Cenník strihov', '#g-strih']],
+    zdroj: [REZ], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'poukazky', otazka: 'Máte darčekové poukážky?',
+    texty: ['Darčekové poukážky sú v ponuke. Podrobnosti ti povie recepcia.'],
+    odkazy: [['Zavolať na recepciu', 'tel:+421951267203']],
+    zdroj: [WEB], overene: '2026-10-20', zobrazit: true,
+  },
+  {
+    id: 'parkovanie', otazka: 'Kde môžem parkovať?',
+    texty: [
+      'Mostná patrí do mestskej parkovacej zóny SM-A. Aktuálne časy a sadzby nájdeš na stránke mesta Nitra.',
+      'Parkové nábrežie a Na Predmostí sú spoplatnené nepretržite.',
+    ], odkazy: [['Parkovanie v Nitre', MESTO]],
+    zdroj: [MESTO], overene: '2026-10-20', zobrazit: true,
+  },
+];
+
+export function overenePolozky(polozky) {
+  return polozky.filter((p) => p.zobrazit === true && Array.isArray(p.zdroj) && p.zdroj.length > 0
+    && p.zdroj.every((url) => /^https:\/\/[^/?#\s]+/.test(url))
+    && /^\d{4}-\d{2}-\d{2}$/.test(p.overene) && Number.isFinite(Date.parse(p.overene))
+    && new Date(p.overene).toISOString().slice(0, 10) === p.overene);
+}
+
+export function spusti(doc = document, win = window) {
+  const host = doc.querySelector('[data-navsteva]');
+  if (!host || host.dataset.ready) return host;
+  const prvok = (tag, text, cls) => {
+    const el = doc.createElement(tag);
+    if (text) el.textContent = text;
+    if (cls) el.className = cls;
+    return el;
+  };
+  const odkaz = ([text, href]) => {
+    const a = prvok('a', text);
+    a.href = href;
+    if (href.startsWith('https://')) { a.target = '_blank'; a.rel = 'noopener'; }
+    return a;
+  };
+  const section = prvok('section', '', 'navsteva');
+  const title = prvok('h2', 'Pred návštevou', 'h2');
+  title.id = 'h-navsteva';
+  section.setAttribute('aria-labelledby', title.id);
+  section.append(title);
+  const grid = prvok('div', '', 'navsteva-grid');
+  for (const p of overenePolozky(OTAZKY)) {
+    const item = prvok(p.kroky ? 'details' : 'article', '', 'navsteva-item');
+    item.dataset.zdroj = p.zdroj.join(' '); item.dataset.overene = p.overene;
+    item.append(prvok(p.kroky ? 'summary' : 'h3', p.otazka));
+    if (p.kroky) {
+      const steps = prvok('ol');
+      p.kroky.forEach((text) => steps.append(prvok('li', text)));
+      item.append(steps);
+    }
+    p.texty.forEach((text) => item.append(prvok('p', text)));
+    if (p.odkazy) {
+      const links = prvok('p', '', 'navsteva-links');
+      p.odkazy.forEach((a) => links.append(odkaz(a))); item.append(links);
+    }
+    grid.append(item);
+  }
+  const sources = prvok('p', '', 'navsteva-sources');
+  sources.append(odkaz(['Rezervačný systém', REZ]), ' · ', odkaz(['Parkovanie v Nitre', MESTO]), ' · ', prvok('span', 'Overené'), ' ');
+  const date = prvok('time', '20. 10. 2026'); date.dateTime = '2026-10-20'; sources.append(date);
+  section.append(grid, sources); host.append(section);
+  host.dataset.ready = 'true'; host.hidden = false;
+  win.dispatchEvent(new win.CustomEvent('bs30:obsah', { detail: { id: host.id } }));
+  // Pri priamom odkaze bol cieľ počas sťahovania skrytý. Polohu opravíme až po preklade a rozložení.
+  if (win.location.hash === '#pred-navstevou') win.requestAnimationFrame(() => {
+    if (win.location.hash !== '#pred-navstevou') return;
+    host.tabIndex = -1;
+    host.scrollIntoView({ block: 'start', behavior: 'instant' });
+    host.focus({ preventScroll: true });
+    win.dispatchEvent(new win.CustomEvent('bs30:skok', { detail: { id: host.id, y: win.scrollY } }));
+  });
+  return host;
+}
