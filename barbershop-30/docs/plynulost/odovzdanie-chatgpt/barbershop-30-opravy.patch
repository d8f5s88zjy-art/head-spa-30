@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+for (const file of ['404.html', 'barbershop-30/404.html']) {
+  const source = fs.readFileSync(new URL('../' + file, import.meta.url), 'utf8');
+  for (const pathname of ['/head-spa-30/barbershop-30/chyba', '/barbershop-30/chyba', '//external.invalid/barbershop-30/chyba', '///external.invalid/barbershop-30/chyba']) {
+    const classes = new Set(file.startsWith('barbershop-30') ? ['b30-error-page'] : []), added = [], home = {}, icon = {}, meta = {};
+    const document = { title: '', documentElement: { classList: { contains: x => classes.has(x), add: x => classes.add(x) } },
+      querySelector: s => s === '[data-b30-home]' ? home : s === 'link[rel=icon]' ? icon : meta,
+      createElement: name => ({ name }), head: { appendChild: node => added.push(node) } };
+    const context = vm.createContext({ document, location: { pathname, origin: 'https://example.test' }, window: {}, URL });
+    for (const match of source.matchAll(/<script>([\s\S]*?)<\/script>/g)) vm.runInContext(match[1], context);
+    const script = added.find(node => node.name === 'script');
+    assert.ok(script, `${file} ${pathname}`);
+    assert.equal(new URL(script.src, context.location.origin).origin, context.location.origin);
+    assert.equal(new URL(home.href, context.location.origin).origin, context.location.origin);
+    assert.equal(new URL(context.window.__b30ErrorBase, context.location.origin).origin, context.location.origin);
+  }
+}
+console.log('OK: 404 cesty a dynamické zdroje ostávajú na pôvodnej doméne.');
