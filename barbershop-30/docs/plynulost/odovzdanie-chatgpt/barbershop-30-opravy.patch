+        const transition = animation = [
+          entry.image.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'linear' }),
+          outgoing.image.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300, easing: 'linear' }),
