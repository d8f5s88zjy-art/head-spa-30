+  const byKey=new Map();
+  for(const t of model.texts){const v=draft.texts?.[t.id];if(!v){errors.push(`${t.label}: chýba text.`);continue;}const k=norm(v.sk),data=JSON.stringify(LOCALES.map(l=>norm(v[l])));if(byKey.has(k)&&byKey.get(k)!==data)errors.push(`Rovnaký text „${k}“ má rozdielne preklady.`);byKey.set(k,data);const changed=LANGS.some(([l])=>norm(v[l])!==norm(t.values[l]));if(!changed)continue;
+    if(!norm(v.sk)||v.sk.length>500)errors.push(`${t.label}: slovenský text musí mať 1 až 500 znakov.`);
+    for(const l of LOCALES){if(!norm(v[l])||v[l].length>1000)errors.push(`${t.label}: doplň preklad ${l.toUpperCase()} (najviac 1 000 znakov).`);}
+    if(t.kind!=='name'&&norm(v.sk)!==t.sk&&!v.reviewed)errors.push(`${t.label}: potvrď, že preklady zodpovedajú novému textu.`);
+    for(const l of LOCALES)if(k!==t.sk && Object.hasOwn(model.dictionaries[l]||{},k) && norm(model.dictionaries[l][k])!==norm(v[l]))errors.push(`${t.label}: tento text už na webe má iný preklad ${l.toUpperCase()}.`);
+  }
+  if(model.settings){if(!draft.settings||!validHours(draft.settings.hours))errors.push('Pri každom otvorenom dni musí byť čas zatvorenia neskôr než otvorenia.');const n=draft.settings?.notice;if(!n||typeof n.enabled!=='boolean'||!n.texts)errors.push('Oznam má neplatný formát.');else {if(n.enabled&&!norm(n.texts.sk))errors.push('Pred zapnutím oznamu doplň slovenský text.');for(const [l]of LANGS)if(typeof n.texts[l]!=='string'||n.texts[l].length>300)errors.push(`Oznam ${l.toUpperCase()} môže mať najviac 300 znakov.`);}}
