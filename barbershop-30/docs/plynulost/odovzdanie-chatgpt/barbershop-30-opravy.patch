@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Malé podklady zo skutočných záberov; spusti z ľubovoľného priečinka (vyžaduje Pillow)."""
+import base64
+import io
+import json
+import re
+from html.parser import HTMLParser
+from pathlib import Path
+
+from PIL import Image, ImageFilter
+
+ROOT = Path(__file__).resolve().parents[2]
+FILM = ROOT / "assets/img/film"
+START, END = "/* NAHLADY-UVOD */", "/* /NAHLADY-UVOD */"
+
+
+class Shots(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.shots = {}
+
+    def handle_starttag(self, tag, attrs):
+        data = dict(attrs)
+        if "data-shot" in data:
+            self.shots[data["data-shot"]] = data
+
+
+def preview(path):
+    with Image.open(path) as source:
+        source = source.convert("RGB")
+        width = 32
+        thumb = source.resize((width, round(source.height * width / source.width)), Image.Resampling.LANCZOS)
+        color = "#%02x%02x%02x" % source.resize((1, 1), Image.Resampling.BOX).getpixel((0, 0))
+        thumb = thumb.filter(ImageFilter.GaussianBlur(0.7))
+        data = io.BytesIO()
+        thumb.save(data, "WEBP", quality=35, method=6, exact=True)
+        return {"src": "data:image/webp;base64," + base64.b64encode(data.getvalue()).decode("ascii"),
+                "color": color, "width": thumb.width, "height": thumb.height}
+
+
+def rule(key, value):
+    shot = key.removesuffix("-m")
+    selector = f'.film-shot[data-shot="{shot}"] .film-still:not(.film-still-pro) img'
+    if shot == "vstup":
+        selector += ",.film-still-pro img"
+    return selector + '{background-image:url("' + value["src"] + '");background-color:' + value["color"] + '}\n'
+
+
+def css(keys, images):
+    wide = "".join(rule(key, images[key]) for key in keys if not key.endswith("-m"))
+    mobile = "".join(rule(key, images[key]) for key in keys if key.endswith("-m"))
+    return wide + "@media(max-width:720px){\n" + mobile + "}\n"
+
+
+def main():
+    parser = Shots()
+    parser.feed((ROOT / "index.html").read_text())
+    images = {}
+    for name, shot in parser.shots.items():
+        for key in (name, shot.get("data-m")):
+            if key:
+                images[key] = preview(FILM / f"{key}-1086.webp")
+        if poster := shot.get("data-video-poster"):
+            images[name + "-video"] = preview(ROOT / (poster + ".webp"))
+    hero = ["rohozka", "vstup", "rohozka-m", "vstup-m"]
+    rest = sorted(key for key in images if key not in hero and not key.endswith("-video"))
+    style = ROOT / "assets/style.css"
+    text = style.read_text()
+    block = START + "\n" + css(hero, images) + END
+    if START in text:
+        text = re.sub(re.escape(START) + r".*?" + re.escape(END), lambda _: block, text, flags=re.S)
+    else:
+        text += "\n" + block + "\n"
+    style.write_text(text)
+    (FILM / "nahlady.css").write_text("/* Podklady vytvorené nástrojom source/tools/nahlady.py. */\n" + css(rest, images))
+    (FILM / "nahlady.json").write_text(json.dumps(images, separators=(",", ":"), ensure_ascii=False) + "\n")
+    print(f"Náhľady: {len(images)}, úvod CSS {len(block.encode())} B, ostatné CSS {(FILM / 'nahlady.css').stat().st_size} B")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/barbershop-30/source/tools/navsteva-browser.mjs b/barbershop-30/source/tools/navsteva-browser.mjs
