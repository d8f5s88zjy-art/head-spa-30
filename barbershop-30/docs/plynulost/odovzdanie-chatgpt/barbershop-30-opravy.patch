+++ b/tools/test-vernost-priprav.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Kontrola vypnutia prihlášky pri chybnom alebo nedostupnom serveri."""
+import importlib.util
+import io
+import json
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from tempfile import TemporaryDirectory
+
+spec = importlib.util.spec_from_file_location('priprava', Path(__file__).with_name('vernost-priprav.py'))
+mod = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(mod)
+
+
+class Response(io.BytesIO):
+    def __init__(self, body, content_type, status=200):
+        super().__init__(body)
+        self.headers = {'Content-Type': content_type}
+        self.status = status
+
+
+class PripravaTest(unittest.TestCase):
+    def test_typ_a_stav_odpovede(self):
+        def reply(request, timeout):
+            if 'api/' in request.full_url:
+                return Response(json.dumps({'ok': True, 'sqlite': True, 'databaza': True, 'admin': {'barbershop': True, 'headspa': False}}).encode(), 'application/json')
+            return Response(b'<!doctype html><html lang="sk"></html>', 'text/html; charset=utf-8')
+        self.assertEqual(mod.dostupnost(reply), {'barbershop': True, 'headspa': False})
+
+    def test_sprava_chyby_nie_je_funkcna_stranka(self):
+        self.assertEqual(mod.dostupnost(lambda *_a, **_kw: Response(b'<html>error</html>', 'text/html', 404)), {})
+        self.assertEqual(mod.dostupnost(lambda *_a, **_kw: Response(b'404', 'text/plain')), {})
+
+    def test_chyba_siete(self):
+        def offline(*_a, **_kw):
+            raise TimeoutError()
+        self.assertEqual(mod.dostupnost(offline), {})
+
+    def test_iba_pripravena_prevadzka_a_opakovany_beh(self):
+        with TemporaryDirectory() as directory:
+            root = Path(directory); (root / 'barbershop-30').mkdir()
+            paths = {'barbershop': root / 'barbershop-30/index.html', 'headspa': root / 'index.html'}
+            for name,path in paths.items():
+                path.write_text(f'<script data-prevadzka="{name}" data-zapnute></script>')
+            with patch.dict(mod.os.environ, {'HESLO_B': 'x'*10, 'HESLO_H': 'x'*10}), patch.object(mod, 'dostupnost', return_value={'barbershop': True, 'headspa': False}):
+                mod.priprav(root); mod.priprav(root)
+            self.assertEqual(paths['barbershop'].read_text().count('data-zapnute'), 1)
+            self.assertNotIn('data-zapnute', paths['headspa'].read_text())
+            with patch.dict(mod.os.environ, {'HESLO_B': '', 'HESLO_H': ''}), patch.object(mod, 'dostupnost', return_value={'barbershop': True}) as health:
+                mod.priprav(root)
+                health.assert_not_called()
+            self.assertNotIn('data-zapnute', paths['barbershop'].read_text())
+
+
+if __name__ == '__main__':
+    unittest.main()
