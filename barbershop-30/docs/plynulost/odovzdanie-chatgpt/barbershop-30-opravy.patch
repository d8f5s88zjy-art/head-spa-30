+#!/usr/bin/env node
+// Deterministické regresie rozhodovania a životnosti. Nenahrádzajú meranie skutočnej grafiky.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import { test } from 'node:test';
+
+const source = fs.readFileSync(new URL('../../assets/film.js', import.meta.url), 'utf8');
+const part = (start, end) => source.slice(source.indexOf(start), source.indexOf(end, source.indexOf(start)));
+const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
+const smooth = (min, max, value) => { const t = clamp((value - min) / (max - min), 0, 1); return t * t * (3 - 2 * t); };
+const flat = {};
+const uniforms = () => ({ uMap: { value: {} }, uDepth: { value: flat }, uAmt: { value: 0 } });
+const shot = (pi, ready = false) => {
+  const value = { pi, photo: `shot-${pi}`, name: `shot-${pi}`, ready, mesh: { visible: false }, mat: { uniforms: uniforms() }, eye: { x: 0, y: 0 } };
+  value.preview = { ...value, ready: false, previewOf: value, mesh: { visible: false }, mat: { uniforms: uniforms() } };
+  return value;
+};
+function drawHarness() {
+  const path = Array.from({ length: 4 }, (_, i) => shot(i));
+  const calls = [], objects = path.flatMap((s) => [s, s.preview]);
+  const vector = () => ({ set() {} });
+  const post = { material: { uniforms: Object.fromEntries(['tA', 'tB', 'uKind', 'uDir', 'uFoc', 'uFoc2', 'uLead', 'uMix'].map((key) => [key, { value: vector() }])) } };
+  const context = vm.createContext({ path, N: 3, S: 1, V: 0, anchors: [0, 1000, 2000, 3000], vhNow: 1000, compiled: true,
+    keepT: 1, keptCi: 0, keptDir: 1, keptAt: 0, clamp, smooth, setTimeout() { return 1; },
+    fade: 0, fadeK: -1, fadeGoal: 0, fadeFreeze: null, still: 1, held: null,
+    pro: null, leaving: null, outside: false, onScreen: new Set(),
+    fin: (s, now) => s.t0 ? Math.min(1, (now - s.t0) / 450) : 1,
+    drive() {}, seqDrive() {}, cutOf() { return null; }, vig: { value: {} }, flat, AMT: 0.3, CK: {}, post,
+    rtA: 'a', rtB: 'b', scene: 'scene', postScene: 'post', camera: {}, postCam: {},
+    renderer: { setRenderTarget(target) { calls.push(['target', target]); }, clear() { calls.push(['clear']); }, render(scene) { calls.push(['draw', scene, objects.filter((s) => s.mesh.visible).map((s) => s.previewOf ? 'preview-' + s.pi : s.photo)]); } },
+    finishTarget() {}, place() {}, showPlace() {}, cutNow: null, mixNow: 0, frames: 0, frameDrawn: false, drawn: false,
+    recoveryReady: false, jumpPending: true, uploaded: false,
+  });
+  vm.runInContext(part('  function draw(now, dt)', '  let drawn ='), context);
+  return { context, calls, path, draw: (now = 1000) => context.draw(now, 1 / 60), objects };
+}
+
+test('nedostupný cieľ bez pripraveného obrazu nemaže plátno', () => {
+  const h = drawHarness(); h.draw(); assert.equal(h.calls.length, 0);
+});
+test('skok na nedostupný cieľ drží poslednú platnú vzdialenú fotografiu', () => {
+  const h = drawHarness(); h.path[3].ready = true; h.context.held = h.path[3];
+  h.context.S = 0; h.draw();
+  assert.deepEqual(h.calls.filter(([name]) => name === 'draw').map((entry) => entry[2]), [['shot-3']]);
+  assert.ok(h.context.onScreen.has(h.path[3]));
+});
+test('náhľad je obrazom, ale neoznačí ostrú fotografiu za hotovú', () => {
+  const h = drawHarness(); h.path[1].preview.ready = true; h.draw();
+  assert.equal(h.path[1].ready, false); assert.equal(h.context.recoveryReady, true);
+  assert.deepEqual(h.calls.filter(([name]) => name === 'draw').map((entry) => entry[2]), [['preview-1']]);
+});
+test('čerstvá fotografia sa prelína z vlastného náhľadu a potom kreslí samostatne', () => {
+  const h = drawHarness(); h.path[1].ready = h.path[1].preview.ready = true; h.path[1].t0 = 900;
+  h.draw();
+  assert.equal(h.calls.filter(([name]) => name === 'draw').length, 3);
+  assert.ok(h.context.mixNow > 0 && h.context.mixNow < 1);
+  h.calls.length = 0; h.draw(1600);
+  assert.deepEqual(h.calls.filter(([name]) => name === 'draw').map((entry) => entry[2]), [['shot-1']]);
+});
+
+function uploadHarness() {
+  const calls = []; let clock = 0, allocated = 0;
+  const gl = { TEXTURE_2D: 1, RGBA: 2, UNSIGNED_BYTE: 3, UNPACK_ALIGNMENT: 4, UNPACK_FLIP_Y_WEBGL: 5, UNPACK_PREMULTIPLY_ALPHA_WEBGL: 6, UNPACK_SKIP_ROWS: 7,
+    pixelStorei() {}, generateMipmap() { calls.push('mip'); }, texSubImage2D(...args) { calls.push(args); } };
+  const context = vm.createContext({ clamp, phone: true, mixNow: 0, jumpPending: false,
+    performance: { now: () => ++clock }, THREE: { LinearMipmapLinearFilter: 1 },
+    renderer: { getContext: () => gl, capabilities: { getMaxAnisotropy: () => 8 }, initTexture() { allocated++; }, properties: { get: () => ({ __webglTexture: {} }) }, state: { bindTexture() {} } },
+    tex: () => ({ source: {}, userData: {}, dispose() { this.disposed = true; } }), wake() {},
+  });
+  vm.runInContext(part('  const gl = renderer.getContext()', '  let avif =') + '\nglobalThis.pending = () => jobs.length; globalThis.cancelAll = () => { while(jobs.length) jobs.shift().cancel(); };', context);
+  const bitmap = (height = 400) => ({ width: 8, height, data: new Uint8Array(8 * height * 4), closes: 0, close() { this.closes++; this.data = null; } });
+  return { context, calls, bitmap, allocated: () => allocated };
+}
+test('fotografia ide po obmedzených pásoch, jeden pás za snímku', async () => {
+  const h = uploadHarness(), image = h.bitmap();
+  const promise = h.context.upload(image, () => true, true);
+  assert.equal(h.allocated(), 0);
+  h.context.pump(); assert.equal(h.calls.filter(Array.isArray).length, 1);
+  while (h.context.pending()) h.context.pump();
+  const texture = await promise;
+  assert.equal(h.allocated(), 1); assert.equal(image.closes, 1);
+  assert.equal(texture.source.data.data, null);
+  assert.equal(h.calls.filter((entry) => entry === 'mip').length, 1);
+  assert.equal(h.calls.filter(Array.isArray).reduce((sum, row) => sum + row[5], 0), 400);
+});
+test('zrušené nahratie uvoľní rozbalenú fotografiu a ukončí promise', async () => {
+  const h = uploadHarness(), image = h.bitmap(); let live = true;
+  const promise = h.context.upload(image, () => live, false);
+  h.context.pump(); live = false; h.context.pump();
+  assert.equal(await promise, null); assert.equal(image.closes, 1); assert.equal(h.context.pending(), 0);
+});
+test('sekvencia opakovane používa existujúcu textúru, najviac jednu snímku za pump', async () => {
