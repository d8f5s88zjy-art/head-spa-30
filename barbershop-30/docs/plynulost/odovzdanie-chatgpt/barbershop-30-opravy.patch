+  const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+};
+const tick = async () => { for (let i = 0; i < 8; i++) await Promise.resolve(); };
+function fixture({ reduced = false, count = 8, confirm = false } = {}) {
+  let id = 0;
+  const frames = new Map(), created = [], commits = [], animations = [], busy = [], errors = [];
+  const flow = photoFlow({ count, reduced: () => reduced,
+    schedule(fn) { frames.set(++id, fn); return id; }, cancel(key) { frames.delete(key); },
+    busy(value) { busy.push(value); }, failed() { errors.push('chyba'); },
+    makeImage(index) {
+      const ready = deferred(), again = deferred();
+      const image = { index, ready, again, style: {}, released: false, removed: false, decodes: 0,
+        decode() { this.decodes++; return confirm && this.decodes > 1 ? again.promise : ready.promise; },
+        remove() { this.removed = true; },
+        removeAttribute(name) { if (name === 'src') this.released = true; },
+        animate(keyframes, options) {
+          const done = deferred();
+          const animation = { image: this, keyframes, options, finished: done.promise, done, cancelled: false,
+            cancel() { this.cancelled = true; done.reject(new Error('Prerušené')); },
+          };
+          animations.push(animation); return animation;
+        },
+      };
+      created.push(image); return image;
+    },
+    commit(entry, old) { commits.push({ index: entry.index, image: entry.image, old: old?.index }); },
+  });
+  const image = (index) => created.findLast((item) => item.index === index && !item.released);
+  const frame = () => { const callbacks = [...frames.values()]; frames.clear(); callbacks.forEach((fn) => fn()); };
+  async function ready(index) { image(index).ready.resolve(); if (confirm) image(index).again.resolve(); await tick(); frame(); await tick(); }
+  return { flow, frames, created, commits, animations, busy, errors, image, frame, ready };
+}
+
+test('fotografia aj popis sa odovzdajú až po decode v spoločnej snímke', async () => {
+  const f = fixture(); f.flow.show(0);
+  assert.equal(f.commits.length, 0);
+  f.image(0).ready.resolve(); await tick();
+  assert.equal(f.commits.length, 0);
+  f.frame(); assert.equal(f.commits[0].image, f.image(0));
+  assert.equal(f.flow.displayed, 0); assert.equal(f.flow.retained, 3);
+  f.flow.show(1); assert.equal(f.flow.displayed, 0);
+  f.image(1).ready.resolve(); await tick();
+  assert.deepEqual(f.commits.map((entry) => entry.index), [0]);
+  f.frame();
+  assert.deepEqual(f.commits.map((entry) => entry.index), [0, 1]);
+  assert.equal(f.commits[1].image, f.image(1));
+  assert.deepEqual(f.animations[0].options, { duration: 300, easing: 'linear' });
+  f.flow.close();
+});
+
+test('päť rýchlych požiadaviek: rozhoduje posledná aj pri opačnom poradí decode', async () => {
+  const f = fixture(); f.flow.show(0); await f.ready(0);
+  for (let index = 1; index <= 5; index++) f.flow.show(index);
+  for (const image of [...f.created].reverse()) image.ready.resolve();
+  await tick(); f.frame();
+  assert.deepEqual(f.commits.map((entry) => entry.index), [0, 5]);
+  assert.equal(f.flow.displayed, 5); assert.equal(f.flow.requested, 5);
+  assert.ok(f.created.filter((image) => !image.released).length <= 3);
+  f.flow.close();
+});
+
+test('zatvorenie počas decode zabráni neskorému zobrazeniu a uvoľní obrázky', async () => {
+  const f = fixture(); f.flow.show(0); f.flow.close();
+  f.created[0].ready.resolve(); await tick(); f.frame();
+  assert.equal(f.commits.length, 0); assert.equal(f.flow.retained, 0);
+  assert.equal(f.flow.displayed, -1); assert.ok(f.created.every((image) => image.released));
+});
+
+test('zatvorenie medzi decode a RAF zruší pripravenú výmenu', async () => {
+  const f = fixture(); f.flow.show(0); f.image(0).ready.resolve(); await tick();
+  assert.equal(f.frames.size, 1);
+  f.flow.close(); f.frame(); assert.equal(f.commits.length, 0); assert.equal(f.frames.size, 0);
+});
+
+test('znovuotvorenie má novú generáciu a nepustí starý decode', async () => {
+  const f = fixture(); f.flow.show(0); const first = f.image(0); f.flow.close();
+  f.flow.show(3); first.ready.resolve(); await tick(); f.frame();
+  assert.equal(f.commits.length, 0);
+  await f.ready(3); assert.deepEqual(f.commits.map((entry) => entry.index), [3]); f.flow.close();
+});
+
+test('nová požiadavka dokončí prebiehajúce prelínanie a drží nanajvýš tri obrázky', async () => {
+  const f = fixture(); f.flow.show(0); await f.ready(0);
+  const first = f.image(0); f.flow.show(1); await f.ready(1);
+  assert.equal(f.flow.retained, 2); assert.equal(first.released, false);
+  f.flow.show(2);
+  assert.equal(f.animations[0].cancelled, true); assert.equal(f.animations[1].cancelled, true); assert.equal(first.released, true);
+  assert.equal(f.flow.displayed, 1); assert.equal(f.image(1).style.opacity, '1');
+  await f.ready(2); assert.equal(f.flow.retained, 2);
+  f.animations.slice(2).forEach((effect) => effect.done.resolve()); await tick();
+  assert.equal(f.flow.retained, 3); assert.equal(f.image(1).released, false);
+  assert.ok(f.created.filter((image) => !image.released).length <= 3);
+  f.flow.close(); assert.ok(f.created.every((image) => image.released));
+});
+
+test('pri rôznom pomere strán vyblednú aj staré okraje a obe vrstvy sa upracú spoločne', async () => {
+  const f = fixture(); f.flow.show(0); await f.ready(0);
+  const landscape = f.image(0); landscape.width = 1600; landscape.height = 900;
+  f.flow.show(1); const portrait = f.image(1); portrait.width = 900; portrait.height = 1600; await f.ready(1);
+  assert.equal(f.animations.length, 2);
+  const [incoming, outgoing] = f.animations;
+  assert.equal(incoming.image, portrait); assert.equal(outgoing.image, landscape);
+  assert.deepEqual(incoming.keyframes, [{ opacity: 0 }, { opacity: 1 }]);
+  assert.deepEqual(outgoing.keyframes, [{ opacity: 1 }, { opacity: 0 }]);
+  assert.deepEqual(incoming.options, outgoing.options);
+  incoming.done.resolve(); await tick(); assert.equal(landscape.released, false);
+  outgoing.done.resolve(); await tick(); assert.equal(landscape.released, true);
+  assert.equal(f.flow.displayed, 1); assert.equal(f.flow.retained, 3);
+  assert.equal(incoming.cancelled, true); assert.equal(outgoing.cancelled, true); f.flow.close();
+});
+
+test('chyba novej fotografie nemení zobrazenú fotografiu ani jej popis', async () => {
+  const f = fixture(); f.flow.show(0); await f.ready(0);
+  f.flow.show(3); f.image(3).ready.reject(new Error('Nedostupná')); await tick(); f.frame();
+  assert.deepEqual(f.commits.map((entry) => entry.index), [0]); assert.equal(f.flow.displayed, 0);
+  assert.equal(f.errors.length, 1); assert.equal(f.busy.at(-1), false); f.flow.close();
+});
+
+test('oneskorená chyba zrušenej požiadavky neprekryje novšiu požiadavku', async () => {
+  const f = fixture(); f.flow.show(0); const stale = f.image(0); f.flow.show(2);
+  stale.ready.reject(new Error('Stará požiadavka')); await tick();
+  assert.equal(f.errors.length, 0); assert.equal(f.busy.at(-1), true);
+  await f.ready(2); assert.equal(f.flow.displayed, 2); f.flow.close();
+});
+
+test('obmedzený pohyb vymení pripravenú fotografiu bez animácie', async () => {
+  const f = fixture({ reduced: true }); f.flow.show(0); await f.ready(0);
+  f.flow.show(1); await f.ready(1);
+  assert.equal(f.flow.displayed, 1); assert.equal(f.animations.length, 0); assert.equal(f.flow.retained, 3); f.flow.close();
+});
+
+test('pred zobrazením sa opäť overí decode toho istého prvku', async () => {
+  const f = fixture({ confirm: true }); f.flow.show(0); const image = f.image(0);
+  image.ready.resolve(); await tick();
+  assert.equal(image.decodes, 2); assert.equal(f.frames.size, 0);
+  image.again.resolve(); await tick(); f.frame();
+  assert.equal(f.commits[0].image, image); f.flow.close();
+});
+
+const pointer = (pointerId, clientX, clientY, pointerType = 'touch') => ({ pointerId, clientX, clientY, pointerType });
+test('švih potrebuje 40 px a vodorovnú prevahu, zvislý a krátky ťah nemenia fotografiu', () => {
+  const changes = [], gesture = swipeGesture({ enabled: () => true, change: (dir) => changes.push(dir) });
+  for (const [x, y] of [[39, 0], [50, 40], [5, 80]]) { gesture.down(pointer(1, 0, 0)); gesture.up(pointer(1, x, y)); }
+  assert.deepEqual(changes, []);
+  gesture.down(pointer(1, 100, 0)); gesture.up(pointer(1, 60, 0));
+  gesture.down(pointer(2, 0, 0)); gesture.up(pointer(2, 40, 0));
+  assert.deepEqual(changes, [1, -1]);
+});
+
+test('pinch s dvoma prstami zruší celú sekvenciu, až nový dotyk môže listovať', () => {
+  const changes = [], gesture = swipeGesture({ enabled: () => true, change: (dir) => changes.push(dir) });
+  gesture.down(pointer(1, 0, 0)); gesture.down(pointer(2, 50, 0));
+  gesture.up(pointer(2, 100, 0)); gesture.up(pointer(1, 120, 0)); assert.deepEqual(changes, []);
+  gesture.down(pointer(3, 100, 0)); gesture.up(pointer(3, 0, 0)); assert.deepEqual(changes, [1]);
+});
+
+test('pointercancel, zatvorenie a priblížený viewport nevyvolajú švih', () => {
+  let enabled = true;
+  const changes = [], gesture = swipeGesture({ enabled: () => enabled, change: (dir) => changes.push(dir) });
+  gesture.down(pointer(1, 0, 0)); gesture.cancel(pointer(1, 0, 0)); gesture.up(pointer(1, 100, 0));
+  gesture.down(pointer(2, 0, 0)); gesture.reset(); gesture.up(pointer(2, 100, 0));
+  gesture.down(pointer(3, 0, 0)); enabled = false; gesture.up(pointer(3, 100, 0));
+  gesture.down(pointer(4, 0, 0)); gesture.up(pointer(4, 100, 0));
+  enabled = true; gesture.down(pointer(5, 0, 0, 'mouse')); gesture.up(pointer(5, 100, 0, 'mouse'));
+  assert.deepEqual(changes, []);
+});
