index 0000000000000000000000000000000000000000..748c5fbe289203779caf35b8042421cc1d80f755
--- /dev/null
+++ b/barbershop-30/source/tools/navsteva-test.mjs
@@ -0,0 +1,119 @@
+#!/usr/bin/env node
+// D6: overené dáta, preklady, rozpočty a správanie lenivého obsahu bez prehliadača.
+// node source/tools/navsteva-test.mjs
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { gzipSync } from 'node:zlib';
+import { OTAZKY, overenePolozky, spusti } from '../../assets/navsteva.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const read = (file) => fs.readFileSync(path.join(root, file), 'utf8');
+const html = read('index.html');
+const module = read('assets/navsteva.js');
+const ld = JSON.parse(html.match(/<script type="application\/ld\+json">([\s\S]*?)<\/script>/)[1]);
+assert.equal(ld['@type'], 'HairSalon');
+assert.equal(ld.priceRange, '3 € – 40 €');
+assert.equal(ld.hasMap, 'https://www.google.com/maps?cid=18132360254733427623');
+assert(!ld.geo && !ld.aggregateRating && !ld.review, 'Nepridávame neoverené súradnice ani hodnotenia');
+assert.equal(ld.hasOfferCatalog.itemListElement.length, 15);
+assert.equal([...html.matchAll(/class="price-amount"/g)].length, 15);
+assert.equal([...html.matchAll(/rel="icon"/g)].length, 1);
+assert.match(html, /<div class="band band-contact" id="kontakt">/);
+assert.match(html, /<footer class="site-footer" id="pata">/);
+assert.equal([...html.matchAll(/class="dnes"/g)].length, 1);
+assert(html.indexOf('class="dnes"') > html.indexOf('id="h-rezervacia"'));
+assert(html.indexOf('id="pred-navstevou"') > html.lastIndexOf('data-shot='), 'FAQ je za kotvami filmu');
+assert.match(html, /id="pred-navstevou" data-navsteva hidden/);
+assert.match(html, /href="pravne.html"/);
+const ids = new Set([...html.matchAll(/\bid="([^"]+)"/g)].map((x) => x[1]));
+for (const [, id] of html.matchAll(/href="#([^"]+)"/g)) assert(ids.has(id), `Kotva ${id}`);
+assert(gzipSync(html, { level: 9 }).length <= 14600, 'HTML do 14 600 B gzip9');
+assert(gzipSync(module, { level: 9 }).length <= 6000, 'FAQ modul do 6 000 B gzip9');
+assert.equal(overenePolozky(OTAZKY).length, 7);
+const valid = OTAZKY[0];
+assert.deepEqual(overenePolozky([
+  { ...valid, zobrazit: false }, { ...valid, zobrazit: 'true' },
+  { ...valid, zdroj: [] }, { ...valid, zdroj: undefined }, { ...valid, zdroj: ['http://example.com'] },
+  { ...valid, zdroj: ['https://'] }, { ...valid, overene: '' }, { ...valid, overene: '2026-02-30' },
+  valid,
+]), [valid], 'Bez platného dôkazu odpoveď neprejde');
+
+const keys = new Set([
+  'Pred návštevou', 'Právne informácie', 'Právne informácie sú po slovensky.', 'Otvorí sa v novom okne',
+  'Potrebuješ pomoc? Zavolaj na +421 951 267 203.', '0951 267 203', 'minimálne čakanie', 'Skupiny cenníka',
+  'Barbera si vyberieš v 2. kroku, alebo zvolíš „Nezáleží“.',
+  'Objednať otvorí rezervačný systém. Službu v ňom vyberieš v 1. kroku.',
+  'Predchádzajúci barber', 'Ďalší barber', 'Načítavam fotografiu…', 'Fotografiu sa nepodarilo načítať.',
+  'Rezervačný systém', 'Parkovanie v Nitre', 'Overené',
+]);
+OTAZKY.forEach((p) => [p.otazka, ...p.texty, ...(p.kroky || []), ...(p.odkazy || []).map((a) => a[0])].forEach((k) => keys.add(k)));
+const descriptions = [...html.matchAll(/<meta (?:name|property)="(?:description|og:description|twitter:description)" content="([^"]+)"/g)].map((x) => x[1]);
+for (const text of descriptions) assert([...text].length <= 155);
+let reference;
+for (const lang of ['en', 'uk', 'hu', 'sr', 'pl', 'de', 'cs']) {
+  const dict = JSON.parse(read(`assets/i18n/${lang}.json`));
+  for (const key of keys) assert(typeof dict[key] === 'string' && dict[key].length, `${lang}: ${key}`);
+  assert.equal(dict['0951 267 203'], '+421 951 267 203');
+  for (const key of descriptions) assert([...dict[key]].length <= 155, `Krátky meta popis ${lang}`);
+  for (const key of ['sviatok', 'onlineNedostupne', 'ariaSviatok', 'overitHodiny']) assert(dict.__tabula[key], `${lang} __tabula.${key}`);
+  assert(dict.__tabula.ariaSviatok.includes('{stav}'));
+  const list = Object.keys(dict).sort();
+  if (reference) assert.deepEqual(list, reference, `Rovnaké kľúče: ${lang}`); else reference = list;
+}
+
+// Malý DOM dvojník kontroluje zápisy a udalosti; netvrdí nič o rozložení v prehliadači.
+function prostredie(hash = '') {
+  const events = [], frames = [], elements = [];
+  const win = {
+    location: { hash }, scrollY: 0,
+    CustomEvent: class { constructor(type, options) { this.type = type; this.detail = options.detail; } },
+    dispatchEvent: (e) => events.push(e), requestAnimationFrame: (f) => frames.push(f),
+  };
+  class El {
+    constructor(tag) { this.tagName = tag; this.children = []; this.dataset = {}; this.attrs = {}; this.calls = []; this.value = ''; elements.push(this); }
+    set textContent(v) { this.value = v; this.children = []; }
+    get textContent() { return this.value + this.children.map((x) => typeof x === 'string' ? x : x.textContent).join(''); }
+    set innerHTML(_) { throw new Error('Obsah sa smie vložiť iba ako text'); }
+    append(...nodes) { this.children.push(...nodes); }
+    setAttribute(k, v) { this.attrs[k] = v; }
+    scrollIntoView(options) { this.calls.push(['scroll', options]); win.scrollY = 7800; }
+    focus(options) { this.calls.push(['focus', options]); }
+  }
+  const host = new El('div'); host.id = 'pred-navstevou'; host.hidden = true;
+  const doc = { createElement: (tag) => new El(tag), querySelector: (selector) => selector === '[data-navsteva]' ? host : null };
+  return { doc, win, host, events, frames, elements };
+}
+const normal = prostredie();
+spusti(normal.doc, normal.win);
+assert.equal(normal.host.hidden, false);
+assert.equal(normal.elements.filter((x) => x.tagName === 'article' || x.tagName === 'details').length, 7);
+assert.equal(normal.elements.filter((x) => x.tagName === 'details').length, 1);
+assert.equal(normal.frames.length, 0, 'Priblíženie ku kontaktu samo neskáče');
+assert.deepEqual(normal.events.map((x) => x.type), ['bs30:obsah']);
+const count = normal.elements.length;
+spusti(normal.doc, normal.win);
+assert.equal(normal.elements.length, count, 'Opakovaný štart neduplikuje odpovede');
+for (const a of normal.elements.filter((x) => x.tagName === 'a')) {
+  assert(/^(https:\/\/|tel:|mailto:|#)/.test(a.href));
+  if (a.href.startsWith('https://')) { assert.equal(a.target, '_blank'); assert.equal(a.rel, 'noopener'); }
+}
+const direct = prostredie('#pred-navstevou');
+spusti(direct.doc, direct.win);
+assert.equal(direct.host.calls.length, 0, 'Poloha čaká na vloženie a ďalší obraz');
+direct.frames.shift()();
+assert.deepEqual(direct.host.calls, [['scroll', { block: 'start', behavior: 'instant' }], ['focus', { preventScroll: true }]]);
+assert.deepEqual(direct.events.at(-1).detail, { id: 'pred-navstevou', y: 7800 });
+const moved = prostredie('#pred-navstevou');
+spusti(moved.doc, moved.win); moved.win.location.hash = '#tim'; moved.frames.shift()();
+assert.equal(moved.host.calls.length, 0, 'Pomalé načítanie návštevníka nevráti po zmene cieľa');
+const textOnly = prostredie();
+OTAZKY.push({ ...OTAZKY[3], otazka: '<img src=x onerror=alert(1)>', texty: ['<b>iba text</b>'] });
+try {
+  spusti(textOnly.doc, textOnly.win);
+  assert(textOnly.host.textContent.includes('<img src=x onerror=alert(1)>'));
+  assert(!textOnly.elements.some((x) => x.tagName === 'img' || x.tagName === 'b'));
+} finally { OTAZKY.pop(); }
+assert.equal(spusti({ querySelector: () => null }, {}), null);
+console.log(`OK D6: zdroje, 7 odpovedí, 7 slovníkov, safe text, idempotencia, hash/fokus/udalosti; HTML ${gzipSync(html, { level: 9 }).length} B, modul ${gzipSync(module, { level: 9 }).length} B gzip9.`);
diff --git a/barbershop-30/source/tools/rezervacia-kontrola.mjs b/barbershop-30/source/tools/rezervacia-kontrola.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..616633dc31a21ffb1d2121bde02cb8f846985b0f
--- /dev/null
+++ b/barbershop-30/source/tools/rezervacia-kontrola.mjs
@@ -0,0 +1,112 @@
+/* Iba verejné čítanie: GET rezervácie, getEmployees a getCalendar pre „Nezáleží“.
+   Bez rezervácie, dostupných časov či údajov zákazníkov. Session a CSRF ostávajú len v pamäti.
+   node source/tools/rezervacia-kontrola.mjs [--json] [--offline=/adresar/verejnych-dokazov]
+   Za proxy: NODE_USE_ENV_PROXY=1 node source/tools/rezervacia-kontrola.mjs */
+import {readFile} from 'node:fs/promises';
+import {resolve} from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {KALENDAR,blokovaneDatumy} from '../../assets/hodiny.js';
+
+export const PAGE='https://www.barbershop30.sk/rezervacia', AJAX=PAGE+'/ajax';
+const norm=s=>String(s).replace(/\s+/g,' ').trim();
+const dec=s=>s.replace(/&(#x[\da-f]+|#\d+|quot|apos|amp|lt|gt|nbsp|euro);/gi,(m,k)=>k[0]==='#'?String.fromCodePoint(k[1].toLowerCase()==='x'?parseInt(k.slice(2),16):parseInt(k.slice(1),10)):({quot:'"',apos:"'",amp:'&',lt:'<',gt:'>',nbsp:' ',euro:'€'}[k.toLowerCase()]));
+const attrs=s=>Object.fromEntries([...s.matchAll(/([\w:-]+)\s*=\s*(["'])([\s\S]*?)\2/g)].map(m=>[m[1],dec(m[3])]));
+const clean=s=>norm(dec(s.replace(/<[^>]*>/g,'')));
+const fail=message=>{throw new Error(message);};
+const json=(text,label)=>{try{return JSON.parse(text);}catch{fail('Neplatný JSON: '+label+'.');}};
+const uniq=(items,key,label)=>{if(new Set(items.map(key)).size!==items.length)fail('Duplicitné '+label+'.');};
+export function parseServices(html){
+  const tag=html.match(/<v-order-component\b[^>]*>/i)?.[0];if(!tag)fail('Chýbajú verejné dáta v-order-component.');
+  const a=attrs(tag);if(a['ajax-url']!==AJAX)fail('Rezervácia zmenila adresu API; kontrola sa zastavila.');
+  const data=json(a.data||'null','verejné služby');return validateServices(data?.services);
+}
+export function validateServices(items){
+  if(!Array.isArray(items)||!items.length||items.length>100)fail('Neplatný zoznam služieb.');
+  for(const s of items)if(!s||!Number.isInteger(s.id)||s.id<=0||typeof s.name!=='string'||!norm(s.name)||s.name.length>300||!Number.isFinite(s.price)||s.price<0||s.price>10000||!Number.isInteger(s.time)||s.time<1||s.time>480)fail('Neplatné pole verejnej služby.');
+  uniq(items,s=>s.id,'ID služieb');uniq(items,s=>norm(s.name),'názvy služieb');return items;
+}
+export function validateEmployees(items){
+  if(!Array.isArray(items)||!items.length||items.length>100)fail('Neplatný zoznam tímu.');
+  for(const e of items)if(!e||!Number.isInteger(e.id)||e.id<0||typeof e.name!=='string'||!norm(e.name)||e.name.length>150||typeof e.title!=='string'||e.title.length>150)fail('Neplatné pole tímu.');
+  uniq(items,e=>e.id,'ID tímu');return items.map(({id,name,title})=>({id,name,title}));
+}
+export function dateISO(value){
+  const m=typeof value==='string'&&value.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);if(!m)fail('Neplatný dátum kalendára.');
+  const d=new Date(Date.UTC(+m[3],+m[2]-1,+m[1]));if(d.getUTCFullYear()!==+m[3]||d.getUTCMonth()!==+m[2]-1||d.getUTCDate()!==+m[1])fail('Neexistujúci dátum kalendára.');return d.toISOString().slice(0,10);
+}
+export function validateCalendar(c){
+  if(!c||!Array.isArray(c.disabled_dates)||c.disabled_dates.length>2000||!Array.isArray(c.disabled_days)||c.disabled_days.some(d=>!['Po','Ut','St','Št','Pi','So','Ne'].includes(d)))fail('Neplatný všeobecný kalendár.');
+  c.disabled_dates.forEach(dateISO);uniq(c.disabled_dates,dateISO,'dátumy');uniq(c.disabled_days,d=>d,'dni');
+  const min=dateISO(c.limits?.min),max=dateISO(c.limits?.max);if(min>max)fail('Obrátený rozsah kalendára.');
+  return {disabled_dates:c.disabled_dates.slice(),disabled_days:c.disabled_days.slice(),limits:{min:c.limits.min,max:c.limits.max}};
+}
+async function limitedText(response){
+  const limit=2*1024*1024;if(Number(response.headers.get('content-length'))>limit)fail('Odpoveď je príliš veľká.');
+  const reader=response.body?.getReader();if(!reader)fail('Prázdna odpoveď.');const decoder=new TextDecoder();let bytes=0,text='';
+  for(;;){const part=await reader.read();if(part.done)break;bytes+=part.value.length;if(bytes>limit){await reader.cancel();fail('Odpoveď je príliš veľká.');}text+=decoder.decode(part.value,{stream:true});}return text+decoder.decode();
+}
+export async function loadReservation({fetcher=fetch}={}){
+  const cookies=new Map();let csrf='';
+  async function request(method,operation,payload={}){
+    if(method!=='GET'&&!['getEmployees','getCalendar'].includes(operation))fail('Nepovolená akcia.');
+    const url=method==='GET'?PAGE:AJAX,headers={Accept:method==='GET'?'text/html':'application/json','User-Agent':'Barbershop30-public-check/1.0'};
+    if(cookies.size)headers.Cookie=[...cookies].map(([k,v])=>k+'='+v).join('; ');
+    if(method==='POST')Object.assign(headers,{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest','X-CSRF-TOKEN':csrf,Origin:new URL(PAGE).origin,Referer:PAGE});
+    let response;try{response=await fetcher(url,{method,headers,redirect:'error',signal:AbortSignal.timeout(15000),...(method==='POST'?{body:JSON.stringify({ajax:true,ajax_method:operation,...payload})}:{})});}catch{fail('Sieťová chyba alebo časový limit pri verejnom čítaní rezervácie.');}
+    if(!response.ok)fail(`Rezervácia vrátila HTTP ${response.status}.`);
+    for(const raw of response.headers.getSetCookie()){const pair=raw.split(';',1)[0],i=pair.indexOf('=');if(i>0)cookies.set(pair.slice(0,i),pair.slice(i+1));}
+    const text=await limitedText(response);if(method==='GET')return text;
+    if(!/application\/json/i.test(response.headers.get('content-type')||''))fail('API nevrátilo JSON.');
+    const data=json(text,'odpoveď rezervácie');if(!data||!Array.isArray(data.errors)||data.errors.length||!data.result)fail('API nevrátilo platný verejný výsledok.');return data.result;
+  }
+  try{
+    const html=await request('GET'),services=validateServices(parseServices(html));
+    for(const tag of html.matchAll(/<meta\b[^>]*>/gi)){const a=attrs(tag[0]);if(a.name==='csrf-token')csrf=a.content||'';}
+    if(!/^[A-Za-z0-9._~+/=-]{20,256}$/.test(csrf)||!cookies.size)fail('Chýba anonymná session alebo CSRF; kontrola sa zastavila.');
+    const employeeData=await request('POST','getEmployees',{services}),employees=validateEmployees(employeeData.employees);
+    const sentinel=employees.find(e=>e.id===0);if(!sentinel||sentinel.name!=='Nezáleží')fail('Chýba všeobecná voľba Nezáleží.');
+    const service=services.find(s=>s.id===1);if(!service)fail('Chýba základná služba pre všeobecný kalendár.');
+    const result=await request('POST','getCalendar',{services:[service],employee:sentinel});
+    if(result.employee?.id!==0)fail('API nevrátilo všeobecný kalendár id0.');
+    const calendar=validateCalendar(result.calendar);
+    return {checkedAt:new Date().toISOString(),source:PAGE,services:services.map(({id,name,price,time})=>({id,name,price,time})),employees,calendar};
+  }finally{cookies.clear();csrf='';}
+}
+export function parseWebsite(html){
+  const field=(s,cls)=>{const m=s.match(new RegExp(`<[^>]+class="[^"]*\\b${cls}\\b[^"]*"[^>]*>([\\s\\S]*?)<\\/[^>]+>`));if(!m)fail('Na webe chýba '+cls+'.');return clean(m[1]);};
+  const services=[...html.matchAll(/<li\b[^>]*class="[^"]*\bprice-row\b[^"]*"[^>]*>[\s\S]*?<\/li>/g)].map(m=>({name:field(m[0],'price-name'),price:Number(field(m[0],'price-amount').replace(/\s|€/g,'').replace(',','.')),time:Number(field(m[0],'price-time').replace(/\s*min$/,''))}));
+  const employees=[...html.matchAll(/<h3\b[^>]*class="[^"]*\bteam-name\b[^"]*"[^>]*>([^<]*)<\/h3>/g)].map(m=>clean(m[1]));
+  const schemas=[...html.matchAll(/<script\b[^>]*type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/g)].map(m=>JSON.parse(m[1])).filter(s=>['HairSalon','BarberShop'].includes(s['@type']));
+  if(schemas.length!==1)fail('Web nemá práve jednu schému prevádzky.');
+  const offers=schemas[0].hasOfferCatalog?.itemListElement;if(!Array.isArray(offers))fail('Chýbajú ponuky JSON-LD.');
+  uniq(services,s=>s.name,'služby HTML');uniq(offers,o=>norm(o.itemOffered?.name),'služby JSON-LD');
+  return{services,employees,offers,schemaType:schemas[0]['@type']};
+}
+// Doložené redakčné opravy: presný názov zdroja aj ID musia sedieť; nikdy nepárujeme podľa ceny.
+const ALIASES={18:['Pánsky strih a Úprava brady','Pánsky strih a úprava brady'],19:['Pánsky strih - dĺžka vlasov nad 10cm','Pánsky strih – dĺžka vlasov nad 10 cm'],5:['Strih pre malých gentlemenov','Strih pre malých gentlemanov'],8:['Depilácia uši a nosa voskom','Depilácia uší a nosa voskom']};
+export function compareReservation(data,html){
+  const web=parseWebsite(html),differences=[],nameNotes=[];const services=validateServices(data.services),employees=validateEmployees(data.employees).filter(e=>e.id!==0),calendar=validateCalendar(data.calendar);
+  const count=(label,actual,expected)=>{if(actual!==expected)differences.push(`${label}: ${actual}, očakávané ${expected}.`);};
+  count('Služby rezervácie',services.length,15);count('Služby HTML',web.services.length,15);count('Ponuky JSON-LD',web.offers.length,15);count('Tím rezervácie',employees.length,10);count('Tím HTML',web.employees.length,10);
+  const used=new Set();for(const s of services){const alias=ALIASES[s.id],name=alias?.[0]===s.name?alias[1]:s.name;used.add(norm(name));const item=web.services.find(x=>norm(x.name)===norm(name)),offer=web.offers.find(o=>norm(o.itemOffered?.name)===norm(name));
+    if(name!==s.name&&item)nameNotes.push({id:s.id,source:s.name,website:name});
+    if(!item)differences.push(`Služba ${s.id} „${s.name}“: chýba v HTML.`);else{if(item.price!==s.price)differences.push(`${name}: cena web ${item.price} €, rezervácia ${s.price} €.`);if(item.time!==s.time)differences.push(`${name}: trvanie web ${item.time} min, rezervácia ${s.time} min.`);}
+    if(!offer)differences.push(`${name}: chýba v JSON-LD.`);else if(Number(offer.price)!==s.price||offer.priceCurrency!=='EUR')differences.push(`${name}: cena alebo mena v JSON-LD nesedí.`);
+  }
+  for(const s of web.services)if(!used.has(norm(s.name)))differences.push(`HTML navyše: ${s.name}.`);
+  for(const o of web.offers)if(!used.has(norm(o.itemOffered?.name)))differences.push(`JSON-LD navyše: ${o.itemOffered?.name}.`);
+  const remoteNames=employees.map(e=>norm(e.name)),webNames=web.employees.map(norm);for(const n of remoteNames)if(!webNames.includes(n))differences.push(`Tím chýba na webe: ${n}.`);for(const n of webNames)if(!remoteNames.includes(n))differences.push(`Tím navyše na webe: ${n}.`);
+  const remoteDates=new Set(calendar.disabled_dates.map(dateISO)),localDates=new Set(blokovaneDatumy());for(const date of remoteDates)if(!localDates.has(date))differences.push(`Kalendár rezervácie blokuje nový deň ${date}.`);for(const date of localDates)if(!remoteDates.has(date))differences.push(`Kalendár už nepotvrdzuje deň ${date}.`);
+  if(JSON.stringify([...calendar.disabled_days].sort())!==JSON.stringify([...KALENDAR.nedostupneDni].sort()))differences.push('Pravidelné blokované dni rezervácie sa zmenili.');
+  return{checkedAt:data.checkedAt||null,source:PAGE,counts:{services:services.length,barbers:employees.length,blockedDates:remoteDates.size},matches:differences.length===0,differences,nameNotes,calendarCoverage:KALENDAR.roky,limits:calendar.limits,note:'Ceny HTML/JSON-LD, minúty HTML, mená a všeobecný online kalendár. JSON-LD trvanie neobsahuje; zatvorenie prevádzky neoverujeme.'};
+}
+async function main(){
+  const args=process.argv.slice(2);if(args.some(a=>a!=='--json'&&!a.startsWith('--offline=')))fail('Použi --json alebo --offline=/adresar.');
+  const offline=args.find(a=>a.startsWith('--offline='))?.slice(10);let data;
+  if(offline){const read=async file=>JSON.parse(await readFile(resolve(offline,file),'utf8'));const [s,e,c]=await Promise.all(['services.json','employees.json','calendar.json'].map(read));if(c.employee?.id!==0)fail('Offline dôkaz nie je všeobecný kalendár id0.');data={services:s.services,employees:e.employees,calendar:c.calendar};}
+  else data=await loadReservation();
+  const report=compareReservation(data,await readFile(new URL('../../index.html',import.meta.url),'utf8'));report.mode=offline?'offline':'live';
+  if(args.includes('--json'))console.log(JSON.stringify(report,null,2));else{console.log(`${report.mode==='live'?report.checkedAt:'OFFLINE – bez nového overenia'} · ${PAGE}`);console.log(`${report.counts.services} služieb · ${report.counts.barbers} barberov · ${report.counts.blockedDates} blokovaných dátumov`);console.log(report.note);for(const n of report.nameNotes)console.log(`Redakčný názov ${n.id}: „${n.source}“ → „${n.website}“`);console.log(report.matches?'OK: porovnávané údaje sedia.':'ROZDIELY:');report.differences.forEach(d=>console.log(' - '+d));}
+  if(!report.matches)process.exitCode=1;
+}
+if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href)main().catch(e=>{console.error('NEOVERENÉ: '+e.message);process.exitCode=2;});
