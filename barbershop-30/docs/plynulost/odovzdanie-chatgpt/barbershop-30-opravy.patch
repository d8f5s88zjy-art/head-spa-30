@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Pripraví zjemnené mapy filmu; pôvodné hĺbkové mapy nemení."""
+from pathlib import Path
+from io import BytesIO
+import math
+from PIL import Image, ImageFilter
+
+ROOT = Path(__file__).resolve().parents[2]
+FILM = ROOT / 'assets' / 'img' / 'film'
+
+
+def prepare(source):
+    # Zhodná šírka a polomer ako pôvodné štyri GPU priechody. Až hotovú mapu
+    # zmenšíme na dvojnásobok hustoty mriežky; hrany ostanú na rovnakom mieste.
+    mobile = source.stem.endswith('-m-hlbka')
+    segments, target = (112, 224) if mobile else (256, 512)
+    with Image.open(source) as original:
+        depth = original.convert('L')
+        if depth.width > 768:
+            depth = depth.resize((768, round(depth.height * 768 / depth.width)), Image.Resampling.BILINEAR)
+        sigma = max(1.5, 1.2 * depth.width / segments)
+        radius = math.floor(2 * sigma + 0.5)
+        depth = depth.filter(ImageFilter.MaxFilter(2 * radius + 1))
+        # Pôvodný shader zaokrúhľoval polomer 3*sigma a sigma potom odvodil z neho.
+        blur_radius = min(40, math.floor(3 * sigma + 0.5)) / 3
+        depth = depth.filter(ImageFilter.GaussianBlur(blur_radius))
+        if depth.width > target:
+            depth = depth.resize((target, round(depth.height * target / depth.width)), Image.Resampling.LANCZOS)
+        destination = source.with_name(source.stem + '-z.webp')
+        buffer = BytesIO()
+        depth.save(buffer, 'WEBP', lossless=True, method=6)
+        temporary = destination.with_suffix('.webp.tmp')
+        temporary.write_bytes(buffer.getvalue())
+        temporary.replace(destination)
+        return destination
+
+
+if __name__ == '__main__':
+    outputs = [prepare(source) for source in sorted(FILM.glob('*-hlbka.webp'))]
+    print(f'{len(outputs)} zjemnených máp, {sum(path.stat().st_size for path in outputs):,} bajtov')
