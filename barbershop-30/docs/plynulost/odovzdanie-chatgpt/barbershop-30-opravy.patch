+#!/usr/bin/env node
+// D6 v skutočnom prehliadači: 2 rozmery × 8 jazykov, priama kotva, kontakt, telefón a preklady.
+// NODE_PATH="$CODEX_PRIMARY_RUNTIME_NODE_MODULES" node source/tools/navsteva-browser.mjs
+// Používa už pripravený Chromium; tento skript nikdy nesťahuje prehliadač.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRequire } from 'node:module';
+import { startStaticServer, PRESETS } from '../shot.mjs';
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+const server = await startStaticServer(root);
+let browser;
+try {
+  browser = await chromium.launch(PRESETS[0]);
+  for (const width of [390, 1440]) for (const lang of ['sk', 'en', 'uk', 'hu', 'sr', 'pl', 'de', 'cs']) {
+    const map = lang === 'sk' ? null : JSON.parse(fs.readFileSync(path.join(root, `assets/i18n/${lang}.json`), 'utf8'));
+    const context = await browser.newContext({ viewport: { width, height: width === 390 ? 844 : 900 }, isMobile: width === 390, hasTouch: width === 390, reducedMotion: 'reduce' });
+    const page = await context.newPage(); const errors = [];
+    page.on('pageerror', (e) => errors.push(e.message));
+    await page.goto(`${server.origin}/?film=off&uvod=off&hudba=off&lang=${lang}#pred-navstevou`);
+    await page.waitForSelector('[data-navsteva][data-ready="true"]');
+    if (map) await page.waitForFunction((l) => window.B30_LANG?.get() === l, lang);
+    await page.waitForFunction(() => document.activeElement.id === 'pred-navstevou');
+    assert.equal(await page.locator('#h-navsteva').textContent(), map?.['Pred návštevou'] || 'Pred návštevou');
+    assert.equal(await page.locator('.navsteva-item').count(), 7);
+    const details = page.locator('details.navsteva-item');
+    assert.equal(await details.count(), 1);
+    await details.locator('summary').click();
+    assert(await details.evaluate((e) => e.open));
+    assert.equal(await details.locator('li').count(), 4);
+    if (map) {
+      assert.equal(await page.locator('.contact-list a[href="tel:+421951267203"]').textContent(), '+421 951 267 203');
+      assert.equal(await page.locator('.booking-note:not([hidden])').count(), 2);
+    } else assert.equal(await page.locator('.booking-note:not([hidden])').count(), 0);
+    await page.waitForFunction(() => [...document.querySelectorAll('a[target="_blank"]')].every((a) => {
+      const ids = (a.getAttribute('aria-describedby') || '').split(/\s+/);
+      return ids.some((id) => document.getElementById(id)?.textContent);
+    }));
+    if (width === 390) await page.locator('.nav-toggle').click();
+    await page.locator('.nav a[href="#kontakt"]').click();
+    assert.equal(await page.evaluate(() => document.activeElement.id), 'kontakt');
+    const card = await page.locator('.contact-main').boundingBox();
+    const head = await page.locator('.site-header').boundingBox();
+    assert(Math.abs(card.y - head.height - 16) <= 8, `Kontakt pri lište: ${lang}/${width}`);
+    const booking = await page.locator('.contact-actions .btn-primary').boundingBox();
+    const available = await page.evaluate(() => innerHeight - (innerWidth <= 900 ? document.querySelector('.mobile-cta')?.getBoundingClientRect().height || 0 : 0));
+    assert(booking.y >= 0 && booking.y + booking.height <= available, `Rezervácia v okne: ${lang}/${width}`);
+    assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), `Šírka bez pretekania: ${lang}/${width}`);
+    assert.deepEqual(errors, []);
+    await context.close();
+  }
+  console.log('OK D6 v prehliadači: 16 kombinácií jazyk/rozmer, FAQ, fokus, kontakt, telefón a popisy odkazov.');
+} finally { await browser?.close(); server.server.close(); }
diff --git a/barbershop-30/source/tools/navsteva-test.mjs b/barbershop-30/source/tools/navsteva-test.mjs
