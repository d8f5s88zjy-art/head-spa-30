+/* Chybová stránka preberie zvolený jazyk; bez siete ostane použiteľná slovenčina. */
+(function () {
+  'use strict';
+  var allowed = ['en', 'uk', 'hu', 'sr', 'pl', 'de', 'cs'], lang = new URLSearchParams(location.search).get('lang');
+  if (!lang) { try { lang = localStorage.getItem('b30.lang'); } catch (e) { /* súkromné okno */ } }
+  if (allowed.indexOf(lang) < 0) return;
+  fetch((window.__b30ErrorBase || '/') + 'assets/i18n/' + lang + '.json', { credentials: 'same-origin' })
+    .then(function (r) { if (!r.ok) throw new Error('Slovník nedostupný'); return r.json(); })
+    .then(function (dict) {
+      var root = document.querySelector('.b30-error'), walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), nodes = [], node;
+      while ((node = walker.nextNode())) nodes.push(node);
+      nodes.forEach(function (n) { var key = n.nodeValue.trim(); if (Object.prototype.hasOwnProperty.call(dict, key) && typeof dict[key] === 'string') n.nodeValue = n.nodeValue.replace(key, dict[key]); });
+      document.documentElement.lang = lang;
+      if (dict['Táto stránka sa nenašla.']) document.title = dict['Táto stránka sa nenašla.'] + ' | BARBERSHOP 30 Nitra';
+    }).catch(function () { /* rezervácia aj kontakt ostávajú dostupné */ });
+})();
