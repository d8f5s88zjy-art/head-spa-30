+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { validateCatalog,embed } from './render-brain.mjs';
+
+function fixture(){const nodes=[],researchers=[];for(let i=1;i<=20;i++){const suffix=String(i).padStart(2,'0');nodes.push({id:'N'+suffix,title:'Odbornosť '+i,researcher_id:'R'+suffix,requires:[]});researchers.push({id:'R'+suffix,parent_node_id:'N'+suffix,source_ids:['S1']});}return {catalog:{nodes,researchers},sources:{sources:[{id:'S1'}]}};}
+test('export vyžaduje úplné páry, jednoznačné ID a známe zdroje',()=>{
+  const good=fixture();assert.equal(validateCatalog(good.catalog,good.sources).catalog.nodes.length,20);
+  const duplicate=fixture();duplicate.catalog.nodes[1].id='N01';assert.throws(()=>validateCatalog(duplicate.catalog,duplicate.sources),/opakujú/);
+  const missing=fixture();missing.catalog.researchers.pop();assert.throws(()=>validateCatalog(missing.catalog,missing.sources),/20/);
+  const mismatched=fixture();mismatched.catalog.researchers[0].parent_node_id='N02';assert.throws(()=>validateCatalog(mismatched.catalog,mismatched.sources),/párovanie/);
+  const source=fixture();source.catalog.researchers[0].source_ids=['nenájdený'];assert.throws(()=>validateCatalog(source.catalog,source.sources),/zdroj/);
+});
+test('vložený obsah nemôže ukončiť skript exportu',()=>{
+  const html=embed('<script>const data=/*KATALOG*/null;</script>',{title:'</script><script>bad()</script>'});
+  assert.equal((html.match(/<script>/g)||[]).length,1);
+  assert.match(html,/\\u003c\/script>/);assert.throws(()=>embed('bez miesta',{}),/Šablóna/);
+});
+test('hotové HTML má 20 párov a nevyžaduje externý skript či štýl',async()=>{
+  const html=await readFile(new URL('./brain.html',import.meta.url),'utf8');
+  const match=html.match(/const data=(\{[^\n]+\});/);assert.ok(match);
+  const data=JSON.parse(match[1]);assert.equal(data.catalog.nodes.length,20);assert.equal(data.catalog.researchers.length,20);
+  assert.doesNotMatch(html,/<script[^>]+src\s*=|<link[^>]+href\s*=|\bfetch\s*\(/i);
+  assert.match(html,/bez živého behu/);assert.match(html,/aria-pressed/);
+});
+test('šírky cieľov sa neprekrývajú pri zlomoch ani na 320 px',async()=>{
+  const html=await readFile(new URL('./brain-template.html',import.meta.url),'utf8');
+  assert.match(html,/\.pair\{width:clamp\(44px,14\.5%,126px\)\}/);
+  assert.match(html,/\.hub\{width:clamp\(64px,16%,105px\)\}/);
+  for(const viewport of [320,390,391,460,640,641,760,840,980,981,1000,1240,1241,1500]){
+    const main=Math.min(viewport,1500),padding=viewport<=390?24:viewport<=640?36:viewport<=1240?52:80;
+    const aside=viewport<=980?0:viewport<=1240?320:365,mapPadding=viewport<=980?0:viewport<=1240?18:25;
+    const width=Math.min(main-padding-aside-mapPadding,viewport<=980?850:1000);
+    const pair=Math.max(44,Math.min(width*.145,126)),hub=Math.max(64,Math.min(width*.16,105));
+    assert.ok(width*.16>=pair,`Susedné dvojice pri ${viewport} px`);
+    assert.ok(width*.19>=(pair+hub)/2,`Dvojica a stred pri ${viewport} px`);
+  }
+});
