+export const REPOSITORY='d8f5s88zjy-art/head-spa-30';
+export const FILES=[PATH+'index.html',...LOCALES.map(l=>PATH+`assets/i18n/${l}.json`)];
+const conflictMessage='Web sa medzičasom zmenil. Stiahni koncept a načítaj aktuálnu verziu. Nič sme neprepísali.';
