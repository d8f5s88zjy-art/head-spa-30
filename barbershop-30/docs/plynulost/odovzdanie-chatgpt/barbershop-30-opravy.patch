@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""Zapne prihlášku len pri dostupnom serveri a pripravenom admine prevádzky."""
+import json
+import os
+from pathlib import Path
+from urllib.request import Request, urlopen
+
+BASE = 'https://www.headspa30.sk/vernost/'
+
+
+def dostupnost(open_url=urlopen):
+    try:
+        for suffix in ('karta/', 'ochrana-udajov.html'):
+            with open_url(Request(BASE + suffix, headers={'Accept': 'text/html'}), timeout=6) as response:
+                body = response.read(1_000_000)
+                if response.status != 200 or 'text/html' not in response.headers.get('Content-Type', '') or b'<html' not in body.lower():
+                    return {}
+        with open_url(Request(BASE + 'api/?a=stav', headers={'Accept': 'application/json'}), timeout=6) as response:
+            if response.status != 200 or 'application/json' not in response.headers.get('Content-Type', ''):
+                return {}
+            state = json.loads(response.read(100_000))
+        if state.get('ok') is not True or state.get('databaza') is not True or state.get('sqlite') is not True:
+            return {}
+        return state.get('admin', {}) if isinstance(state.get('admin'), dict) else {}
+    except Exception:
+        return {}
+
+
+def priprav(root=Path('_site')):
+    ready = dostupnost() if any(len(os.environ.get(k, '')) >= 10 for k in ('HESLO_B', 'HESLO_H')) else {}
+    for name, key, path in [('barbershop', 'HESLO_B', root / 'barbershop-30/index.html'), ('headspa', 'HESLO_H', root / 'index.html')]:
+        marker = f'data-prevadzka="{name}"'
+        content = path.read_text().replace(marker + ' data-zapnute', marker)
+        enabled = len(os.environ.get(key, '')) >= 10 and ready.get(name) is True
+        if enabled:
+            content = content.replace(marker, marker + ' data-zapnute')
+        path.write_text(content)
+        print(f'{name}: vernostná prihláška ' + ('zapnutá' if enabled else 'vypnutá'))
+
+
+if __name__ == '__main__':
+    priprav()
