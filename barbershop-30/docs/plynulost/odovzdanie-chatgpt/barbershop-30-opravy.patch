+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import fs from 'node:fs';
+
+const source = fs.readFileSync(new URL('../../assets/vernost.js', import.meta.url), 'utf8');
+const karta = 'https://www.headspa30.sk/vernost/karta/?k=' + 'a'.repeat(22);
+function init(saved = '', active = false) {
+  const storage = new Map(saved ? [['v30.karta.barbershop', saved]] : []), events = {};
+  const footer = { hidden: true }, link = { href: 'https://www.headspa30.sk/vernost/karta/', setAttribute(k, v) { this[k] = v; }, removeAttribute(k) { delete this[k]; } };
+  const document = {
+    currentScript: { getAttribute: (k) => k === 'data-prevadzka' ? 'barbershop' : null, hasAttribute: () => active },
+    documentElement: { lang: 'sk' }, readyState: 'loading',
+    querySelectorAll: (s) => s === '[data-vernost-footer]' ? [footer] : [link],
+    addEventListener: (type, f) => { (events[type] ||= []).push(f); }
+  };
+  vm.runInNewContext(source, {
+    document, URL, window: { fetch() {}, HTMLDialogElement() {}, open() { throw Error('Test nesmie otvárať externú stránku'); } },
+    localStorage: { getItem: k => storage.get(k), setItem: (k, v) => storage.set(k, v), removeItem: k => storage.delete(k) },
+    sessionStorage: { getItem() {}, setItem() {} }, setTimeout() {},
+    addEventListener: (type, f) => { (events[type] ||= []).push(f); }
+  });
+  return { footer, link, events, storage };
+}
+assert.equal(init().footer.hidden, true);
+assert.equal(init('', true).footer.hidden, false);
+assert.equal(init(karta).link.href, karta);
+assert.equal(init(karta).footer.hidden, false);
+for (const url of [karta.replace('www.headspa30.sk', 'example.com'), karta.replace('https:', 'http:'), karta + '#bad', karta + '&extra=1', 'javascript:alert(1)']) assert.equal(init(url).footer.hidden, true, url);
+const state = init(karta); state.storage.clear(); state.events.storage[0]({ key: null });
+assert.equal(state.footer.hidden, true);
+assert.equal(state.link.href, undefined);
+let stopped = false;
+state.events.click.at(-1)({ target: { closest: () => state.link }, preventDefault() { stopped = true; } });
+assert.equal(stopped, true);
+console.log('OK: skrytie, dôveryhodná adresa, neplatné adresy, zmena úložiska, vypnutý odkaz.');
