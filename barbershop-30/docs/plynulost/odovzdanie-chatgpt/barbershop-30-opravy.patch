+export function swipeGesture({ enabled, change }) {
+  const pointers = new Set(); let first = null, blocked = false;
+  return {
+    down(event) {
+      if (event.pointerType === 'mouse' || !enabled()) return;
+      pointers.add(event.pointerId);
