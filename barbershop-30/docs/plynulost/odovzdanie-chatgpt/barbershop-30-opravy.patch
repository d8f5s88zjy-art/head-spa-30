+++ b/barbershop-30/source/tools/admin-browser.mjs
@@ -0,0 +1,45 @@
+/* Skutočný prehliadač, lokálny web a výhradne simulovaný GitHub. */
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import {readFile,mkdtemp} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+const require=createRequire(import.meta.url),{chromium}=require('playwright');
+const base=new URL(process.env.ADMIN_BASE_URL||'http://127.0.0.1:8000/barbershop-30/admin/');
+const A='a'.repeat(40),B='b'.repeat(40),C='c'.repeat(40),D='d'.repeat(40),calls=[];
+const workflow=await readFile(new URL('../../../.github/workflows/pages.yml',import.meta.url),'utf8'),[,rawURL,publishedURL]=workflow.match(/sed -i 's#(https:[^#]+)#(https:[^#]+)#g'/);
+const output=process.env.ADMIN_SCREENSHOT_DIR||await mkdtemp(join(tmpdir(),'barbershop-admin-'));
+let browser;
+try{browser=await chromium.launch({headless:true});}catch(e){console.error('BLOCKED: Chromium nie je dostupný. Browser test neprebehol.\n'+e.message);process.exit(2);}
+try{
+  const context=await browser.newContext({viewport:{width:1440,height:1000}}),errors=[];
+  await context.route('**/*',async route=>{const request=route.request(),url=new URL(request.url());if(url.origin===base.origin){if(url.pathname===new URL('../index.html',base).pathname){const raw=await readFile(new URL('../../index.html',import.meta.url),'utf8');return route.fulfill({status:200,contentType:'text/html',body:raw.replaceAll(rawURL,publishedURL)});}return route.continue();}if(url.origin!=='https://api.github.com')return route.abort();const path=url.pathname.replace('/repos/d8f5s88zjy-art/head-spa-30',''),body=request.postDataJSON();calls.push({method:request.method(),path,body});let data;
+    if(path==='/git/ref/heads/main')data={object:{sha:A}};
+    else if(path.startsWith('/contents/barbershop-30/')){assert.equal(url.searchParams.get('ref'),A);const relative=path.replace('/contents/barbershop-30/','');assert(/^(index\.html|assets\/i18n\/(en|uk|hu|sr|pl|de|cs)\.json)$/.test(relative));data={encoding:'base64',content:Buffer.from(await readFile(new URL('../../'+relative,import.meta.url))).toString('base64')};}
+    else if(path==='/git/commits/'+A)data={tree:{sha:B}};
+    else if(path==='/git/trees')data={sha:D};
+    else if(path==='/git/commits')data={sha:C};
+    else if(path==='/git/refs/heads/main'){assert.equal(body.force,false);data={object:{sha:C}};}
+    else throw new Error('Nepovolená požiadavka: '+path);
+    return route.fulfill({status:200,contentType:'application/json',body:JSON.stringify(data)});
+  });
+  const page=await context.newPage();page.on('pageerror',e=>errors.push(e.message));
+  await page.goto(base.href);await page.locator('#content:not([hidden])').waitFor();
+  assert.equal(await page.locator('h1').textContent(),'Všetko na svojom mieste.');
+  const sourceCheck=await page.evaluate(async()=>{const m=await import('./model.mjs');const html=await(await fetch('../index.html')).text(),dicts=Object.fromEntries(await Promise.all(m.LOCALES.map(async l=>[l,await(await fetch('../assets/i18n/'+l+'.json')).json()])));const model=m.parseModel(html,dicts),draft=m.freshDraft(model);return{services:model.services.length,team:model.team.length,unchanged:Object.keys(m.buildFiles(model,draft)).length,errors:m.validate(model,draft),settings:!!model.settings};});
+  assert.deepEqual(sourceCheck,{services:15,team:10,unchanged:0,errors:[],settings:true});
+  await page.screenshot({path:join(output,'admin-desktop.png'),fullPage:true});
+  await page.locator('[data-section="prices"]').click();await page.locator('[data-price="service-0"][data-key="price"]').fill('19.5');await page.locator('#review').click();
+  assert((await page.locator('#review-content').textContent()).includes('19.5 €'));
+  assert.equal(calls.length,0);await page.locator('#publish').click();await page.locator('#token').fill('test-only-key');await page.locator('#connect-form button[type="submit"]').click();await page.locator('#connect-dialog').waitFor({state:'hidden'});
+  assert.equal(await page.locator('#token').inputValue(),'');assert.equal(calls.filter(c=>c.method!=='GET').length,0);
+  await page.locator('#price-confirm').check();await page.locator('#publish').click();await page.locator('#review-dialog').waitFor({state:'hidden'});
+  assert.equal(calls.filter(c=>c.method==='PATCH').length,1);const tree=calls.find(c=>c.path==='/git/trees').body;assert.equal(tree.base_tree,B);assert(tree.tree[0].content.includes('19,50 €'));assert(tree.tree[0].content.includes(rawURL));assert(!tree.tree[0].content.includes(publishedURL));
+  assert((await page.locator('#message').textContent()).includes('Zmeny sú uložené'));
+  await page.locator('[data-section="notice"]').click();await page.locator('#notice-sk').fill('</script><img src=x onerror=alert(1)>');assert.equal(await page.locator('#notice-preview img').count(),0);assert((await page.locator('#notice-preview').textContent()).startsWith('</script>'));
+  await page.setViewportSize({width:390,height:844});await page.locator('[data-section="hours"]').click();
+  assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
+  await page.locator('[data-hour="1"][data-index="0"]').fill('09:30');await page.locator('[data-hour="1"][data-index="1"]').fill('18:15');await page.locator('#review').click();assert((await page.locator('#review-content').textContent()).includes('09:30–18:15'));await page.locator('[data-close="review-dialog"]').click();
+  await page.screenshot({path:join(output,'admin-mobile.png'),fullPage:true});
+  assert.deepEqual(errors,[]);console.log('PASS: model reálneho zdroja, desktop/mobile, bez horizontálneho scrollu, diff, bezpečný oznam, explicitné uloženie, GitHub iba mock.');console.log('Screenshoty: '+output);
+}finally{await browser.close();}
