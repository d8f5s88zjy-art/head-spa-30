@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+import { readFile, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { loadStore, transact, ready, blockers, artifactManifest, verifySubmission, digest, writeSnapshot, withStoreLock } from './engine.mjs';
+
+const ownDir = dirname(fileURLToPath(import.meta.url));
+const args = process.argv.slice(2);
+function option(flag,fallback){const at=args.indexOf(flag);if(at<0)return fallback;const value=args[at+1];if(!value||value.startsWith('--')){console.error('Zastavené: chýba cesta za '+flag);process.exit(1);}args.splice(at,2);return resolve(value);}
+const dir = option('--dir',ownDir);
+const root = option('--root',resolve(ownDir, '../..'));
+const [command, task, actor, receiptPath, ...tail] = args;
+const help = `Pracovná sieť · iba lokálne prideľovanie a odovzdanie
+
+  status                          overí denník a vypíše aktuálny stav
+  ready                           vráti úlohy pripravené na pridelenie
+  claim ÚLOHA VLASTNÍK             rezervuje rozsah súborov
+  submit ÚLOHA VLASTNÍK RECEIPT    odovzdá súbory a vykonané kontroly
+  review ÚLOHA KONTROLÓR RECEIPT   prijme alebo vráti presnú revíziu
+  retry ÚLOHA NOVÁ_HYPOTÉZA        začne ďalšiu opravu v limite maxRetries
+  fail ÚLOHA VLASTNÍK quota|error DÔVOD
+  pause DÔVOD                     zastaví ďalšie prideľovanie
+  resume OVERENÝ_DÔVOD            obnoví prideľovanie, úlohy neštartuje
+  recover ÚLOHA NOVÁ_HYPOTÉZA      pripraví blokovanú úlohu na ďalší pokus
+  cancel ÚLOHA DÔVOD              uvoľní vlastníctvo bez potvrdenia výsledku
+  revision REVÍZIA DÔVOD          zmení vstup po ukončení rozpracovanej práce
+  role ROLA RUNTIME_ID STAV       zapíše overené ID pracovníka (active/pending/idle)
+  scope ÚLOHA RECEIPT             zmení cesty pred odovzdaním, kontroluje konflikty
+  render                          obnoví snapshot.json a index.html
+
+Voliteľne --dir PRIEČINOK_STAVU --root KOREŇ_PROJEKTU. Hodnoty s medzerami vlož do úvodzoviek.
+Nástroj iba vracia zadania. Pracovníkov spúšťa koordinátor dostupnými prostriedkami.
+`;
+
+async function render() {
+  return withStoreLock(dir, async () => {
+    const { state } = await loadStore(dir);
+    const template = await readFile(resolve(ownDir, 'dashboard.html'), 'utf8');
+    const payload = JSON.stringify(state).replaceAll('<', '\\u003c').replaceAll('\u2028', '\\u2028').replaceAll('\u2029', '\\u2029');
+    const html = template.replace('/*STAV*/null', payload);
+    if (html === template) throw new Error('V šablóne chýba miesto pre stav.');
+    await writeSnapshot(dir, state);
+    await writeFile(resolve(dir, 'index.html'), html);
+    return { page: resolve(dir, 'index.html'), snapshotAt: state.updatedAt, events: state.eventIds.length };
+  });
+}
+try {
+  if (!command || command === 'help' || command === '--help') { process.stdout.write(help); process.exit(0); }
+  const { state } = await loadStore(dir);
+  if (command === 'status') {
+    console.log(JSON.stringify({ project: state.project, revision: state.revision, paused: state.paused, pauseReason: state.pauseReason, snapshotAt: state.updatedAt,
+      tasks: state.tasks.map(t => ({ id: t.id, title: t.title, owner: t.owner, state: t.state, retries: t.retries, blockers: blockers(state, t) })) }, null, 2));
+  } else if (command === 'ready') {
+    console.log(JSON.stringify({ paused: state.paused, pauseReason: state.pauseReason, assignments: ready(state).map(t => ({ id: t.id, owner: t.owner, action: t.state === 'rework' ? 'retry' : 'claim', inputRevision: t.inputRevision, paths: t.paths, acceptance: t.acceptance, hypothesis: t.hypothesis || null })) }, null, 2));
+  } else if (command === 'render') {
+    console.log(JSON.stringify(await render(), null, 2));
+  } else {
+    let event;
+    if (command === 'submit' || command === 'review') {
+      if (!receiptPath) throw new Error('Chýba cesta k odovzdávke JSON.');
+      const receipt = JSON.parse(await readFile(resolve(receiptPath), 'utf8'));
+      const currentTask = state.tasks.find(t => t.id === task);
+      if (!currentTask) throw new Error('Neznáma úloha.');
+      if (command === 'submit') {
+        const artifacts = await artifactManifest(root, receipt.artifacts);
+        event = { type: command, task, actor, inputRevision: receipt.inputRevision, artifacts, outputRevision: digest(JSON.stringify(artifacts)), checks: receipt.checks, summary: receipt.summary };
+      } else {
+        await verifySubmission(root, currentTask);
+        event = { type: command, task, actor, inputRevision: receipt.inputRevision, outputRevision: receipt.outputRevision, verdict: receipt.verdict, checks: receipt.checks, summary: receipt.summary };
+      }
+    } else if (command === 'claim') event = { type: 'claim', task, actor };
+    else if (command === 'fail') event = { type: 'fail', task, actor, reason: receiptPath, summary: tail.join(' ') };
+    else if (command === 'pause' || command === 'resume') event = { type: command, actor: 'root', summary: args.slice(1).join(' ') };
+    else if (command === 'retry' || command === 'recover') event = { type: command, task, actor: 'root', hypothesis: args.slice(2).join(' ') };
+    else if (command === 'cancel') event = { type: command, task, actor: 'root', summary: args.slice(2).join(' ') };
+    else if (command === 'revision') event = { type: command, actor: 'root', revision: task, summary: args.slice(2).join(' ') };
+    else if (command === 'role') event = { type: command, actor: 'root', role: task, runtimeId: actor, status: receiptPath };
+    else if (command === 'scope') {
+      if (!actor) throw new Error('Chýba odovzdávka rozsahu JSON.');
+      const receipt = JSON.parse(await readFile(resolve(actor), 'utf8'));
+      event = { type: command, actor: 'root', task, paths: receipt.paths, summary: receipt.summary };
+    }
+    else throw new Error('Neznámy príkaz. Použi help.');
+    await transact(dir, event, { root });
+    console.log(JSON.stringify({ saved: true, event: event.type, task: task || null }));
+    try { console.log(JSON.stringify(await render(), null, 2)); }
+    catch (error) { throw new Error(`Udalosť je uložená. Prehľad obnov príkazom render. ${error.message}`); }
+  }
+} catch (error) { console.error(`Zastavené: ${error.message}`); process.exitCode = 1; }
