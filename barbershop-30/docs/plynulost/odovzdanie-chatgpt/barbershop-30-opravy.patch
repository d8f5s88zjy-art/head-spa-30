+const names = [...html.matchAll(/data-shot="([^"]+)"/g)].map((m) => m[1]);
+for (const name of names) for (const key of [name, `${name}-m`]) {
+  assert(previews[key], `Chýba náhľad ${key}`);
+  assert.match(previews[key].src, /^data:image\/webp;base64,/);
+  assert.match(previews[key].color, /^#[0-9a-f]{6}$/);
+  assert.equal(previews[key].width, 32);
+  assert(previews[key].height > 0);
+}
+for (const key of ['sala-video', 'stol-video', 'sala-rano-video']) assert(previews[key], key);
+assert(fs.statSync(path.join(root, 'assets/img/film/nahlady.css')).size <= 12000, 'Rozpočet odložených náhľadov');
+assert(gzipSync(html, { level: 9 }).length <= 14600, 'Rozpočet HTML (gzip -9 podľa PLAN.md)');
+const settings = JSON.parse(html.match(/<script\b[^>]*id="barbershop-settings"[^>]*>([\s\S]*?)<\/script>/)[1]);
+assert.deepEqual(settings.hours, { 0: null, 1: [9, 19], 2: [9, 19], 3: [9, 19], 4: [9, 19], 5: [9, 19], 6: [9, 14] });
+console.log('OK náhľady, nastavenia a rozpočty súborov');
+if (process.argv.includes('--assets-only')) process.exit(0);
+
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+const { startStaticServer, PRESETS } = await import('../shot.mjs');
+const server = await startStaticServer(root);
+let browser;
+try {
+  browser = await chromium.launch(PRESETS[0]);
+  const errors = [];
+  const context = await browser.newContext({ viewport: { width: 1440, height: 900 }, reducedMotion: 'no-preference' });
+  const page = await context.newPage();
+  page.on('pageerror', (e) => errors.push(e.message));
+  let delay = false;
+  await page.route('**/assets/img/film/*', async (route) => {
+    if (delay && !/rohozka|nahlady/.test(route.request().url())) await new Promise((resolve) => setTimeout(resolve, 1800));
+    await route.continue();
+  });
+  await page.goto(`${server.origin}/?film=off&uvod=off&hudba=off`);
+  await page.waitForSelector('[data-shot="rohozka"].is-ready');
+  delay = true;
+  await page.evaluate(() => { window.jumps = []; addEventListener('bs30:skok', (e) => window.jumps.push(e.detail)); });
+  await page.locator('.nav a[href="#galeria"]').click();
+  const jump = await page.evaluate(() => ({ hash: location.hash, focus: document.activeElement.id, y: scrollY, jumps: window.jumps, near: [...document.querySelectorAll('.is-near')].map((s) => s.dataset.shot) }));
+  assert.equal(jump.hash, '#galeria'); assert.equal(jump.focus, 'galeria');
+  assert.equal(jump.jumps.at(-1).id, 'galeria'); assert.equal(jump.jumps.at(-1).y, jump.y);
+  assert(jump.near.length <= 4, 'Pri skoku len susedia cieľa a prípadná držaná fotka');
+  await page.waitForTimeout(750);
+  const pending = await page.locator('[data-shot="kava"] .film-still').evaluate((el) => ({ opacity: +getComputedStyle(el).opacity, preview: getComputedStyle(el.querySelector('img')).backgroundImage }));
+  assert.equal(pending.opacity, 1, 'Poistka po 600 ms ukáže cieľ');
+  assert.match(pending.preview, /data:image\/webp;base64/, 'Cieľ má podklad aj bez plnej fotky');
+  assert.equal(await page.evaluate(() => scrollY), jump.y, 'Skok sa ďalej neposúva');
+  await page.locator('.nav a[href="#tim"]').click();
+  await page.goBack();
+  await page.waitForTimeout(400);
+  assert.equal(await page.evaluate(() => location.hash), '#galeria');
+  assert(Math.abs(await page.evaluate(() => scrollY) - jump.y) <= 1, 'Späť obnoví polohu');
+  await page.evaluate(() => scrollTo({ top: document.querySelector('#remeslo').getBoundingClientRect().top + scrollY + 20, behavior: 'instant' }));
+  await page.waitForTimeout(1000);
+  assert(await page.evaluate(() => [...document.querySelectorAll('.title-frame, .film-still')].every((el) => {
+    const value = +el.style.getPropertyValue(el.classList.contains('title-frame') ? '--o' : '--so'); return value === 0 || value === 1;
+  })), 'Karty v pokoji dosadnú na 0 alebo 1');
+  assert.deepEqual(errors, []);
+  await context.close();
+
+  const mobile = await browser.newContext({ viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true, deviceScaleFactor: 3, reducedMotion: 'reduce' });
+  const phone = await mobile.newPage();
+  await phone.goto(`${server.origin}/?film=off&hudba=off`);
+  assert(await phone.locator('.team-video').isVisible(), 'Telefón v pokojnej verzii ukáže tímové video/plagát');
+  await phone.evaluate(() => scrollTo({ top: 150, behavior: 'instant' }));
+  await phone.waitForTimeout(350);
+  assert(await phone.locator('.mobile-progress').isVisible());
+  await phone.locator('.nav-toggle').click();
+  assert.equal(await phone.locator('.nav').evaluate((el) => getComputedStyle(el).backgroundColor), 'rgb(14, 13, 12)');
+  assert(await phone.evaluate(() => document.documentElement.scrollWidth <= innerWidth), 'Telefón nepreteká');
+  await mobile.close();
+
+  // Všetky dni zatvorené musia skončiť, zlomky hodín sa zobrazia ako minúty a oznam je iba text.
+  const custom = await browser.newContext({ reducedMotion: 'reduce' });
+  const configPage = await custom.newPage();
+  const allClosed = Object.fromEntries(Array.from({ length: 7 }, (_, n) => [n, null]));
+  const notice = '<img src=x onerror="alert(1)">';
+  const config = { hours: allClosed, notice: { enabled: true, texts: { sk: notice, en: '' } } };
+  await configPage.route('**/index.html?*', (route) => route.fulfill({ contentType: 'text/html', body: html.replace(/(<script\b[^>]*id="barbershop-settings"[^>]*>)[\s\S]*?(<\/script>)/, (_, a, b) => a + JSON.stringify(config).replace(/</g, '\\u003c') + b) }));
+  await configPage.goto(`${server.origin}/index.html?film=off&motion=off&hudba=off`);
+  await configPage.locator('.nav a[href="#rezervacia"]').click();
+  await configPage.locator('[data-flap]').scrollIntoViewIfNeeded();
+  await configPage.waitForFunction(() => document.querySelector('[data-flap]').getAttribute('aria-label')?.includes('ZATVORENÉ'));
+  await configPage.waitForFunction(() => !document.querySelector('[data-shop-notice]')?.hidden);
+  assert.equal(await configPage.locator('[data-shop-notice]').textContent(), notice);
+  assert.equal(await configPage.locator('[data-shop-notice] img').count(), 0);
+  config.hours = Object.fromEntries(Array.from({ length: 7 }, (_, n) => [n, [9.5, 19.25]]));
+  await configPage.reload();
+  await configPage.locator('[data-flap]').scrollIntoViewIfNeeded();
+  await configPage.waitForFunction(() => document.querySelector('[data-flap]').getAttribute('aria-label')?.includes('9:30'));
+  assert.match(await configPage.locator('[data-flap]').getAttribute('aria-label'), /19:15/);
+  await custom.close();
+  console.log('OK kotvy, pomalá sieť, pokojné karty, telefón a bezpečné nastavenia');
+} finally {
+  await browser?.close();
+  server.server.close();
+}
