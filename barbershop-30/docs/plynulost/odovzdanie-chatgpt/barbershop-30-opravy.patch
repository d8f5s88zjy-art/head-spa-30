+++ b/tools/pracovna-siet/engine.test.mjs
@@ -0,0 +1,123 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, readFile, mkdir, rm, symlink } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import { digest, overlaps, safePath, validateState, applyEvent, ready, blockers, loadStore, transact, artifactManifest } from './engine.mjs';
+
+let sequence = 0;
+const checks = [{name:'Kontrola skúšobného súboru',status:'pass',evidence:'Izolovaný test, mimo projektu.'}];
+const ev = (type,rest={}) => ({id:String(++sequence),at:'2026-10-20T12:00:00Z',type,actor:'root',...rest});
+function seed(){return {
+  version:1,project:'Izolovaný test',revision:'v1',maxActive:2,maxRetries:2,paused:false,pauseReason:'',eventIds:[],
+  roles:[{id:'root',label:'Riadenie',kind:'coordinator'},{id:'one',label:'Jeden',kind:'implementation'},{id:'two',label:'Dva',kind:'implementation'},{id:'reviewer',label:'Kontrola',kind:'review'}],
+  tasks:[{id:'one',title:'Prvá',owner:'one',inputRevision:'v1',paths:['a/'],dependsOn:[],state:'pending',retries:0},{id:'two',title:'Druhá',owner:'two',inputRevision:'v1',paths:['b/'],dependsOn:['one'],state:'pending',retries:0}]
+};}
+function submit(state,id='one'){
+  const artifacts=[{path:id==='one'?'a/file.txt':'b/file.txt',sha256:'a'.repeat(64)}];
+  return applyEvent(state,ev('submit',{task:id,actor:id,inputRevision:'v1',outputRevision:digest(JSON.stringify(artifacts)),artifacts,checks}));
+}
+function reviewed(state,verdict='accept',id='one'){
+  return applyEvent(state,ev('review',{task:id,actor:'reviewer',inputRevision:'v1',outputRevision:state.tasks.find(t=>t.id===id).submission.outputRevision,verdict,checks,summary:'Vykonaná nezávislá testová kontrola.'}));
+}
+async function temporary(t){const dir=await mkdtemp(resolve(tmpdir(),'pracovna-siet-'));t.after(()=>rm(dir,{recursive:true,force:true}));await writeFile(resolve(dir,'state.json'),JSON.stringify(seed()));return dir;}
+
+test('vlastníctvo rozlišuje súbory, celé priečinky a podobné názvy',()=>{
+  assert.equal(overlaps('a/','a/file.txt'),true);
+  assert.equal(overlaps('a/','a/sub/'),true);
+  assert.equal(overlaps('a/file.txt','a/file.txt'),true);
+  assert.equal(overlaps('a/file.txt','a/file.txt2'),false);
+  assert.equal(overlaps('a/','ab/'),false);
+  assert.equal(safePath('../outside'),false);assert.equal(safePath('/absolute'),false);assert.equal(safePath('a/*'),false);
+  let s=seed();s.tasks[1].paths=['a/sub/'];s.tasks[1].dependsOn=[];
+  s=applyEvent(s,ev('claim',{task:'one',actor:'one'}));
+  assert.match(blockers(s,s.tasks[1]).join(' '),/Súbory drží one/);
+  assert.throws(()=>applyEvent(s,ev('claim',{task:'two',actor:'two'})),/Súbory drží/);
+});
+test('závislosť je splnená až nezávislým prijatím presného výstupu',()=>{
+  let s=seed();assert.deepEqual(ready(s).map(t=>t.id),['one']);
+  assert.throws(()=>applyEvent(s,ev('claim',{task:'one',actor:'two'})),/iná rola/);
+  s=applyEvent(s,ev('claim',{task:'one',actor:'one'}));s=submit(s);
+  assert.equal(ready(s).length,0);
+  const receipt={task:'one',actor:'one',inputRevision:'v1',outputRevision:s.tasks[0].submission.outputRevision,verdict:'accept',checks,summary:'Kontrola'};
+  assert.throws(()=>applyEvent(s,ev('review',receipt)),/nezávislá/);
+  assert.throws(()=>applyEvent(s,ev('review',{...receipt,actor:'reviewer',inputRevision:'old'})),/starú/);
+  assert.throws(()=>applyEvent(s,ev('review',{...receipt,actor:'reviewer',outputRevision:'old'})),/inému/);
+  assert.throws(()=>applyEvent(s,ev('review',{...receipt,actor:'reviewer',checks:[]})),/dôkaz/);
+  assert.throws(()=>applyEvent(s,ev('review',{...receipt,actor:'reviewer',checks:[{...checks[0],status:'fail'}]})),/úspešný/);
+  assert.equal(applyEvent(s,ev('review',{...receipt,actor:'reviewer',verdict:'rework',checks:[{...checks[0],status:'fail'}]})).tasks[0].state,'rework');
+  s=reviewed(s);assert.deepEqual(ready(s).map(t=>t.id),['two']);
+  assert.equal(s.tasks[0].acceptedRevision,'v1');
+});
+test('podvrhnuté dokončenie bez kontroly a cyklus sa odmietnu',()=>{
+  const s=seed();s.tasks[0].state='done';s.tasks[0].acceptedRevision='v1';
+  assert.throws(()=>validateState(s),/odovzdanie/);
+  const cyclic=seed();cyclic.tasks[0].dependsOn=['two'];assert.throws(()=>validateState(cyclic),/cyklus/);
+});
+test('opakované opravy sú obmedzené a každá potrebuje novú hypotézu',()=>{
+  let s=applyEvent(seed(),ev('claim',{task:'one',actor:'one'}));
+  for(let round=1;round<=3;round++){
+    s=reviewed(submit(s),'rework');assert.equal(s.tasks[0].retries,round);
+    if(round<3){
+      assert.throws(()=>applyEvent(s,ev('claim',{task:'one',actor:'one'})),/hypotézou/);
+      assert.throws(()=>applyEvent(s,ev('retry',{task:'one',hypothesis:''})),/hypotézu/);
+      s=applyEvent(s,ev('retry',{task:'one',hypothesis:'Nová príčina '+round}));
+    }
+  }
+  assert.equal(s.paused,true);assert.equal(s.tasks[0].state,'blocked');assert.deepEqual(ready(s),[]);
+  s=applyEvent(s,ev('resume',{summary:'Skontrolovaná dostupnosť'}));
+  assert.throws(()=>applyEvent(s,ev('recover',{task:'one',hypothesis:'Ďalší rovnaký pokus'})),/voľný pokus/);
+});
+test('kvóta zastaví nové prideľovanie a obnova nespustí prácu automaticky',()=>{
+  const start=seed();start.tasks[1].dependsOn=[];
+  let s=applyEvent(start,ev('claim',{task:'one',actor:'one'}));
+  s=applyEvent(s,ev('fail',{task:'one',actor:'one',reason:'quota',summary:'Vyčerpaný dostupný limit.'}));
+  assert.deepEqual(ready(s),[]);
+  assert.throws(()=>applyEvent(s,ev('recover',{task:'one',hypothesis:'Voľný limit'})),/obnov sieť/);
+  s=applyEvent(s,ev('resume',{summary:'Nová dostupná kapacita je overená.'}));assert.equal(s.tasks[0].state,'blocked');
+  s=applyEvent(s,ev('recover',{task:'one',hypothesis:'Obnovená kapacita'}));
+  assert.equal(s.tasks[0].state,'pending');assert.equal(s.tasks[0].retries,1);
+});
+test('rozsah sa nedá rozšíriť cez vlastníctvo druhej úlohy',()=>{
+  const start=seed();start.tasks[1].dependsOn=[];
+  let s=applyEvent(start,ev('claim',{task:'one',actor:'one'}));s=applyEvent(s,ev('claim',{task:'two',actor:'two'}));
+  assert.throws(()=>applyEvent(s,ev('scope',{task:'one',paths:['a/','b/'],summary:'Nový súbor'})),/Konflikt/);
+  s=applyEvent(s,ev('scope',{task:'one',paths:['a/','tests/one.mjs'],summary:'Vlastný regresný test'}));
+  assert.ok(s.tasks[0].paths.includes('tests/one.mjs'));
+  assert.throws(()=>applyEvent(s,ev('revision',{revision:'v2',summary:'Nový vstup'})),/rozpracované/);
+});
+test('revízia zneplatní predchádzajúce prijatie',()=>{
+  let s=reviewed(submit(applyEvent(seed(),ev('claim',{task:'one',actor:'one'}))));
+  s=applyEvent(s,ev('revision',{revision:'v2',summary:'Nové vstupy'}));
+  assert.equal(s.tasks[0].state,'pending');assert.equal(s.tasks[0].acceptedRevision,undefined);assert.equal(s.tasks[1].inputRevision,'v2');
+});
+test('denník sa prehrá presne, zmena udalosti alebo základu sa odmietne',async t=>{
+  const dir=await temporary(t);const state=await transact(dir,{type:'claim',task:'one',actor:'one'});
+  assert.deepEqual((await loadStore(dir)).state,state);
+  const original=await readFile(resolve(dir,'events.jsonl'),'utf8');
+  const altered=JSON.parse(original);altered.event.task='two';await writeFile(resolve(dir,'events.jsonl'),JSON.stringify(altered)+'\n');
+  await assert.rejects(loadStore(dir),/odtlačok/);
+  await writeFile(resolve(dir,'events.jsonl'),original);const changed=seed();changed.project='Zmena zdroja';await writeFile(resolve(dir,'state.json'),JSON.stringify(changed));
+  await assert.rejects(loadStore(dir),/poradie/);
+});
+test('súbežný zápis neobíde výhradný zámok',async t=>{
+  const dir=await temporary(t);await writeFile(resolve(dir,'.write-lock'),'');
+  await assert.rejects(transact(dir,{type:'claim',task:'one',actor:'one'}),/iný proces/);
+  assert.equal((await loadStore(dir)).sequence,0);
+});
+test('kontrola odmietne súbor zmenený od odovzdania',async t=>{
+  const dir=await temporary(t);await mkdir(resolve(dir,'a'));await writeFile(resolve(dir,'a/file.txt'),'pôvodný');
+  await transact(dir,{type:'claim',task:'one',actor:'one'});
+  const artifacts=await artifactManifest(dir,['a/file.txt']);const outputRevision=digest(JSON.stringify(artifacts));
+  await transact(dir,{type:'submit',task:'one',actor:'one',inputRevision:'v1',artifacts,outputRevision,checks});
+  await writeFile(resolve(dir,'a/file.txt'),'neskoršia úprava');
+  const review={type:'review',task:'one',actor:'reviewer',inputRevision:'v1',outputRevision,checks,verdict:'accept',summary:'Test'};
+  await assert.rejects(transact(dir,review,{root:dir}),/zmenili/);assert.equal((await loadStore(dir)).sequence,2);
+  await writeFile(resolve(dir,'a/file.txt'),'pôvodný');await transact(dir,review,{root:dir});assert.equal((await loadStore(dir)).state.tasks[0].state,'done');
+});
+test('artefakty neuniknú cez relatívnu cestu ani symbolický odkaz',async t=>{
+  const dir=await temporary(t);const outside=await mkdtemp(resolve(tmpdir(),'mimo-projektu-'));t.after(()=>rm(outside,{recursive:true,force:true}));
+  await writeFile(resolve(outside,'secret.txt'),'test');await symlink(resolve(outside,'secret.txt'),resolve(dir,'escape'));
+  await assert.rejects(artifactManifest(dir,['../secret.txt']),/relatívnu/);
+  await assert.rejects(artifactManifest(dir,['escape']),/v projekte/);
+});
