+  if (model.settings && draft.settings) { if(!same(model.settings.hours,draft.settings.hours)) out.push({label:'Otváracie hodiny',before:'Doterajší rozpis',after:'Nový týždenný rozpis',section:'hours'}); if(!same(model.settings.notice,draft.settings.notice)) out.push({label:'Oznam na webe',before:model.settings.notice?.enabled?'Zapnutý':'Vypnutý',after:draft.settings.notice?.enabled?draft.settings.notice.texts.sk:'Vypnutý',section:'notice'}); }
+  return out;
+}
