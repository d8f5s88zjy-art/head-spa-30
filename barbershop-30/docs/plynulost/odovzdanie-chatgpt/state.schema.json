{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pracovná sieť · uložený stav",
  "type": "object",
  "required": ["version", "project", "revision", "maxActive", "maxRetries", "paused", "eventIds", "roles", "tasks"],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "maxActive": {"type": "integer", "minimum": 1, "maximum": 6},
    "maxRetries": {"type": "integer", "minimum": 0, "maximum": 3},
    "paused": {"type": "boolean"},
    "pauseReason": {"type": "string"},
    "eventIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "roles": {"type": "array", "items": {"type": "object", "required": ["id", "label", "kind"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "kind": {"enum": ["coordinator", "implementation", "review", "memory", "research"]}, "runtimeId": {"type": ["string", "null"]}}}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "check": {"type": "object", "required": ["name", "status", "evidence"], "properties": {"name": {"type": "string", "minLength": 1}, "status": {"const": "pass"}, "evidence": {"type": "string", "minLength": 1}}},
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "submission": {"type": ["object", "null"], "required": ["inputRevision", "outputRevision", "artifacts", "checks"], "properties": {"inputRevision": {"type": "string"}, "outputRevision": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}}},
    "task": {
      "type": "object", "required": ["id", "title", "owner", "inputRevision", "paths", "dependsOn", "state", "retries"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "inputRevision": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "state": {"enum": ["pending", "active", "review", "rework", "blocked", "done"]}, "retries": {"type": "integer", "minimum": 0},
        "acceptance": {"type": "array", "items": {"type": "string"}}, "submission": {"$ref": "#/$defs/submission"}, "acceptedRevision": {"type": "string"}
      }
    }
  }
}
