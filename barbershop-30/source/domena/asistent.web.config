<?xml version="1.0" encoding="UTF-8"?>
<!-- Asistent Barber na IIS: knižnice, dáta, znalosti a konfigurácia sú z webu zakázané. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" /><add segment="data" /><add segment="znalosti" /><add segment="vendor" /><add segment="config.php" /><add segment=".user.ini" /><add segment="subory.sha256" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
