# Asistent Barber a voľné termíny (plný balík www.barbershop30.sk) – Apache. Zvonku je dostupné len api.php a stránka
# o ochrane údajov; knižnice, dáta, znalosti a konfigurácia nie. Len mod_rewrite a mod_headers (bez Options a bez
# DirectoryIndex). RewriteEngine On zároveň znamená, že pravidlá koreňového .htaccess (rezervačný systém) sa tu neuplatnia.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|data|znalosti|vendor|testy)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.example\.php|composer\.(json|lock)|README\.md)$ - [F,L]
  RewriteRule (^|/)\.(user\.ini|ht) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|sha256)$ - [F,L]
  RewriteRule ^$ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# odpoveď ide po kúskoch, kompresia by ju zadržala do konca
<IfModule mod_env.c>
  SetEnv no-gzip 1
</IfModule>
