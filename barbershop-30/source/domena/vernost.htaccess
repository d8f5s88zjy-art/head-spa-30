# Vernostná kartička (plný balík www.barbershop30.sk) – Apache. Do knižnice, dát a konfigurácie sa zvonku nedá dostať.
# Len mod_rewrite a mod_headers (bez Options a bez DirectoryIndex – úvodné súbory priečinkov rieši RewriteRule, takže
# nezávisia od nastavenia hostingu). RewriteEngine On zároveň znamená, že pravidlá koreňového .htaccess (rezervačný
# systém) sa tu neuplatnia.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|data|testy)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.example\.php|README\.md)$ - [F,L]
  RewriteRule (^|/)\.(user\.ini|ht) - [F,L]
  RewriteRule \.(sqlite|sqlite-wal|sqlite-shm|db)$ - [F,L]
  RewriteRule ^$ index.html [L]
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^admin/?$ admin/index.html [L]
  RewriteRule ^karta/?$ karta/index.html [L,QSA]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "\.(html|js|css)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>
