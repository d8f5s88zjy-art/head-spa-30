<?xml version="1.0" encoding="UTF-8"?>
<!-- Správa webu na IIS: dostupný len index.php a súbory v assets/; jadro, šablóny, kostry, testy zakázané.
     Na Windows hostingu Forpsi PHP nie je, správa tam nepôjde a tento súbor tam nemá účinok; na IIS nebola správa nikdy spustená. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.php" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <!-- hlásenia správy (403, 404, 500 s vysvetlením pre majiteľa) nenahrádzať chybovými stránkami webu z koreňového web.config -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="jadro" /><add segment="jadro" /><remove segment="obrazovky" /><add segment="obrazovky" /><remove segment="sablony" /><add segment="sablony" /><remove segment="kostry" /><add segment="kostry" />
          <remove segment="testy" /><add segment="testy" /><remove segment="semeno" /><add segment="semeno" /><remove segment=".user.ini" /><add segment=".user.ini" /><remove segment="verzia.json" /><add segment="verzia.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol><customHeaders><remove name="X-Robots-Tag" /><add name="X-Robots-Tag" value="noindex, nofollow" /><remove name="X-Content-Type-Options" /><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
