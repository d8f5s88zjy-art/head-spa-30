<?xml version="1.0" encoding="UTF-8"?>
<!-- Správa webu na IIS (Forpsi Windows): dostupný len index.php a súbory v assets/; jadro, šablóny, kostry, testy zakázané. -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.php" /></files></defaultDocument>
    <directoryBrowse enabled="false" />
    <!-- hlásenia správy (403, 404, 500 s vysvetlením pre majiteľa) nenahrádzať chybovými stránkami webu z koreňového web.config -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="jadro" /><add segment="obrazovky" /><add segment="sablony" /><add segment="kostry" />
          <add segment="testy" /><add segment="semeno" /><add segment=".user.ini" /><add segment="verzia.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol><customHeaders><add name="X-Robots-Tag" value="noindex, nofollow" /><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
