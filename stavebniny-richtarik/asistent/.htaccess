# ASISTENT STAVEBNÍN RICHTÁRIK – Apache. Zvonku je dostupné len api.php a ochrana-udajov.html;
# knižnice, dáta, znalosti, testy a konfigurácia nie (lib/, data/ a znalosti/ majú aj vlastný .htaccess pre hosting
# bez mod_rewrite).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|data|znalosti|vendor|testy)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.example\.php|composer\.(json|lock)|README\.md|web\.config)$ - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# odpoveď ide po kúskoch, kompresia by ju zadržala do konca
<IfModule mod_env.c>
  SetEnv no-gzip 1
</IfModule>
