<?xml version="1.0" encoding="UTF-8"?>
<!-- Nahrávky zo správy webu (IIS; na Windows hostingu Forpsi PHP nie je a správa tam nepôjde, na Linuxe je súbor bez účinku): len čítanie súborov .pdf; žiadne spúšťanie skriptov. -->
<configuration>
  <system.webServer>
    <!-- bez <handlers>: sekcia býva na hostingu zamknutá (chyba 500.19); spúšťanie skriptov zakazuje allowUnlisted="false" -->
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <remove fileExtension=".pdf" /><add fileExtension=".pdf" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    
    <httpProtocol><customHeaders><remove name="X-Content-Type-Options" /><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
