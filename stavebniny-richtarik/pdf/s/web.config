<?xml version="1.0" encoding="UTF-8"?>
<!-- Nahrávky zo správy webu (IIS): len čítanie súborov .pdf; žiadne spúšťanie skriptov. -->
<configuration>
  <system.webServer>
    <!-- bez <handlers>: sekcia býva na hostingu zamknutá (chyba 500.19); spúšťanie skriptov zakazuje allowUnlisted="false" -->
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".pdf" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    
    <httpProtocol><customHeaders><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
  </system.webServer>
</configuration>
